.service-card {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  margin-bottom: 9rpx;
  padding: 14rpx;
  border: 1rpx solid #eadbd2;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
}

.service-image-wrap {
  position: relative;
  flex: 0 0 220rpx;
  align-self: center;
  width: 220rpx;
  height: 250rpx;
  border: 1rpx solid #ddd;
  overflow: hidden;
}

.service-image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  background: #eee;
}

.service-gallery-icon {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 34rpx;
  height: 34rpx;
  transform: scaleX(-1);
  filter: brightness(0) invert(1) drop-shadow(0 1rpx 3rpx rgba(0, 0, 0, 0.3));
}

.service-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  gap: 12rpx;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.service-tag {
  padding: 3rpx 12rpx;
  background: #fde4eb;
  color: #d06884;
  font-size: 25rpx;
  line-height: 32rpx;
}

.service-name {
  overflow: hidden;
  color: #606060;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-note {
  white-space: pre-wrap;
  word-break: break-all;
  margin-top: 10rpx;
  color: #777;
  font-size: 27rpx;
  line-height: 38rpx;
}

.service-meta {
  display: flex;
  min-width: 0;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.service-price-slot {
  flex: 1;
  min-width: 0;
}

.service-duration {
  flex: 0 0 auto;
  white-space: nowrap;
  text-align: right;
  color: #999;
  font-size: 28rpx;
  line-height: 40rpx;
}
