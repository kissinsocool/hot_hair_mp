.review-helpful {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  color: #999;
  font-size: 28rpx;
  line-height: 40rpx;
}

.review-helpful.active {
  color: #b95370;
}

.review-helpful-icon {
  width: 32rpx;
  height: 32rpx;
}

.review-helpful-count {
  margin-top: 14rpx;
  color: #999;
  font-size: 30rpx;
  line-height: 40rpx;
}
