.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  height: calc(54px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #f4eeee;
  background: #fff;
  transform: translateY(0);
  transition: transform 220ms ease-out;
  will-change: transform;
}

.tabbar-hidden {
  pointer-events: none;
  transform: translateY(100%);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  padding-top: 7px;
  color: #4d4a54;
}

.tab.active {
  color: #4d4a54;
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 28px;
  margin-bottom: 5px;
  border-radius: 999px;
}

.tab.active .tab-icon-wrap {
  background: #fdf0f4;
}

.tab-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 23.33px;
  height: 23.33px;
  transform: translate(-50%, -50%);
}

.tab-icon-hidden {
  opacity: 0;
}

.tab-text {
  max-width: 100%;
  font-size: 11.2px;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}
