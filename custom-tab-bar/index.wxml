<view wx:if="{{!hidden}}" class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{item.selected ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <image class="tab-icon" mode="aspectFit" src="{{item.selected ? item.selectedIconPath : item.iconPath}}" />
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
