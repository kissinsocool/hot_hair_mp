.service-price { min-width: 0; }
.price-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx; }
.discount { color: #d50938; font-size: 38rpx; line-height: 52rpx; }
.selling-price { position: relative; white-space: nowrap; display: flex; align-items: baseline; color: #111; }
.currency { align-self: flex-start; margin-right: 2rpx; font-size: 28rpx; line-height: 38rpx; }
.amount { color: #111; font-size: 48rpx; line-height: 62rpx; }
.limited-offer { position: absolute; top: 0; left: 100%; margin-left: 6rpx; padding: 3rpx 8rpx; border-radius: 4rpx; background: #d50938; color: #fff; font-size: 22rpx; line-height: 28rpx; }
.original { margin-top: 4rpx; color: #666; font-size: 26rpx; line-height: 36rpx; }
.original-amount { white-space: nowrap; text-decoration: line-through; }
.compact .discount { font-size: 26rpx; line-height: 36rpx; }
.compact .amount { font-size: 32rpx; line-height: 42rpx; }
.compact .original { font-size: 21rpx; line-height: 30rpx; }
.compact .currency { font-size: 22rpx; line-height: 30rpx; }
.compact .limited-offer { font-size: 20rpx; line-height: 26rpx; }
