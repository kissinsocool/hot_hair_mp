/* 与订单页头部保持一致。 */
.tab-appbar {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 28rpx;
  background: #2B2726;
}

.tab-appbar-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 58rpx;
}
