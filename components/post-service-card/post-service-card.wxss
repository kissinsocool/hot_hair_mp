.post-service {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  min-height: 174rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 2rpx solid #e1e1e1;
  border-radius: 20rpx;
  background: #fff;
}

.post-service-label {
  display: flex;
  flex: 0 0 58rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #d67590;
  color: #fff;
  font-size: 23rpx;
  line-height: 27rpx;
  text-align: center;
}

.post-service-main {
  flex: 1;
  min-width: 0;
}

.post-service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.post-service-name {
  color: #363636;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 37rpx;
  word-break: break-all;
}

.post-service-note {
  margin-top: 8rpx;
  color: #363636;
  font-size: 27rpx;
  line-height: 35rpx;
}

.post-service-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 12rpx;
}

.post-service-arrow {
  align-self: center;
  box-sizing: border-box;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  border-top: 5rpx solid #b8b8b8;
  border-right: 5rpx solid #b8b8b8;
  transform: rotate(45deg);
}

.post-service-text {
  margin-top: 12rpx;
  color: #999;
  font-size: 25rpx;
}

.service-tag {
  padding: 3rpx 12rpx;
  background: #fde4eb;
  color: #d06884;
  font-size: 25rpx;
  line-height: 32rpx;
}

/* 紧凑模式：详情页横向动态卡片里使用。左侧名称和简介，右侧粉色价格和箭头。 */
.post-service-compact {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 16rpx 16rpx 16rpx 20rpx;
  border: 2rpx solid #e1e1e1;
  border-radius: 14rpx;
  background: #fff;
}

.post-service-compact--active {
  background: #faf7f5;
}

.post-service-compact-main {
  flex: 1;
  min-width: 0;
}

.post-service-compact-name,
.post-service-compact-note {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-service-compact-name {
  color: #333;
  font-size: 25rpx;
  line-height: 34rpx;
}

.post-service-compact-note {
  margin-top: 2rpx;
  color: #888;
  font-size: 22rpx;
  line-height: 30rpx;
}

.post-service-compact-price {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  align-items: flex-end;
  margin-left: 16rpx;
}

.post-service-compact-amount {
  color: #d06884;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
  white-space: nowrap;
}

.post-service-compact-original {
  color: #999;
  font-size: 20rpx;
  line-height: 26rpx;
  text-decoration: line-through;
  white-space: nowrap;
}

.post-service-compact-arrow {
  flex: 0 0 16rpx;
  box-sizing: border-box;
  width: 16rpx;
  height: 16rpx;
  margin: 0 6rpx 0 16rpx;
  border-top: 3rpx solid #999;
  border-right: 3rpx solid #999;
  transform: rotate(45deg);
}

.post-service-text--compact {
  margin-top: 14rpx;
  overflow: hidden;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
