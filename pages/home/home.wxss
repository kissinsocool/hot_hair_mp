@import '../../styles/featured-badge.wxss';

.home {
  min-height: 100vh;
  background: #fffdfb;
}

.appbar {
  padding: 0 28rpx 13rpx;
  background: #f3dce7;
}

.appbar-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.location {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: calc(100% - 256rpx);
  height: 48rpx;
  color: #3a202c;
}

.top-icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  margin-right: 18rpx;
}

.location-text {
  min-width: 0;
  max-height: 48rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.arrow-icon {
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
  margin-left: 18rpx;
}

.message-btn {
  position: relative;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin: 0 194rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #3a202c;
}

.message-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.message-icon {
  width: 44rpx;
  height: 44rpx;
}

.message-dot {
  position: absolute;
  top: -17rpx;
  left: 30rpx;
  box-sizing: border-box;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 3rpx solid #f3dce7;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
  text-align: center;
  white-space: nowrap;
}

.search button::after {
  border: 0;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-top: 14rpx;
  padding: 0 8rpx 0 46rpx;
  border-radius: 999rpx;
  background: #fff;
}

.search input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #656565;
  font-size: 32rpx;
  font-weight: 700;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin-right: 8rpx;
}

.search-clear image {
  width: 45rpx;
  height: 45rpx;
  padding: 3rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.12);
}

.search button {
  width: 90rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #f3dce7;
  color: #3a202c;
  font-size: 28rpx;
  font-weight: 700;
}

.suggestions {
  position: relative;
  z-index: 5;
  margin: 12rpx 20rpx 0;
  padding: 6rpx 16rpx;
  border: 1rpx solid #e8dcd0;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.suggestion {
  padding: 10rpx 0;
  border-top: 1rpx solid #f4e7df;
}

.suggestion:first-child {
  border-top: 0;
}

.suggestion-name {
  overflow: hidden;
  color: #5a5a5a;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: #999;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list {
  padding: 0;
}

.tabbar-spacer {
  height: calc(54px + env(safe-area-inset-bottom));
}

.ad-link {
  display: block;
  height: 142rpx;
  margin: 20rpx 20rpx 0;
  overflow: hidden;
}

.ad-banner {
  width: 100%;
  height: 100%;
}

.notice {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin: 18rpx 20rpx;
  padding: 0 20rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: rgba(232, 162, 176, 0.08);
}

.notice-icon {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  margin-right: 16rpx;
}

.notice-window {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.notice-text {
  position: absolute;
  top: 0;
  left: 0;
  padding-right: 80rpx;
  color: #d06884;
  font-size: 30rpx;
  line-height: 72rpx;
  animation: notice-marquee 24s linear infinite;
}

.notice-text + .notice-text {
  animation-delay: -12s;
}

.location-fallback {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 20rpx 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(232, 162, 176, 0.08);
}

.location-fallback-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.location-fallback-text {
  flex: 1;
  min-width: 0;
  color: #5a5a5a;
  font-size: 26rpx;
}

.location-fallback-action {
  flex: 0 0 auto;
  color: #d06884;
  font-size: 26rpx;
  font-weight: 700;
}

.home-coupon-tip {
  margin: 0 20rpx;
}

.category-finder-title,
.salon-list-title {
  margin: 0 30rpx 18rpx;
  color: #615555;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.category-finder {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid #dedede;
  background: #fff;
}

.category-finder-title {
  margin: 22rpx 0 0;
  padding: 24rpx 30rpx 18rpx;
  background: #f7f4f2;
}

.category-finder-item {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 50%;
  height: 148rpx;
  padding: 0 50rpx 0 22rpx;
  border-right: 1rpx solid #dedede;
  border-bottom: 1rpx solid #dedede;
}

.category-finder-item:nth-child(2n) {
  border-right: 0;
}

.category-finder-image {
  flex: 0 0 100rpx;
  width: 100rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.category-finder-label {
  margin-left: 17rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.category-finder-arrow {
  position: absolute;
  top: 50%;
  right: 25rpx;
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #b8b8b8;
  border-right: 3rpx solid #b8b8b8;
  transform: translateY(-50%) rotate(45deg);
}

.salon-list-section {
  padding-top: 24rpx;
  background: #f7f4f2;
}

.salon-list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 30rpx;
}

.salon-sort {
  display: flex;
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 2rpx solid #d9d2ce;
  border-radius: 12rpx;
  background: #fff;
}

.salon-sort-option {
  min-width: 74rpx;
  padding: 6rpx 14rpx;
  color: #403937;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.salon-sort-option + .salon-sort-option {
  border-left: 2rpx solid #d9d2ce;
}

.salon-sort-active {
  background: #403937;
  color: #fff;
}

@keyframes notice-marquee {
  from { transform: translate3d(100%, 0, 0); }
  to { transform: translate3d(-100%, 0, 0); }
}

.loading,
.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a8a8a;
}

.empty-title {
  color: #5a5a5a;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-sub {
  margin-top: 12rpx;
  color: #8a8a8a;
}

.retry {
  width: 100%;
  height: 53rpx;
  line-height: 53rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #d06884;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 店铺卡片按 393pt 宽设计稿（iPhone 14 Pro）还原：1pt ≈ 1.9084rpx。 */
.salon-card {
  position: relative;
  margin: 0 30.5rpx 30.5rpx;
  padding: 21rpx 30.5rpx 0;
  overflow: hidden;
  border-radius: 15.3rpx;
  background: #fff;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.1);
}


.salon-card-border-light {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 4rpx;
  border-radius: inherit;
  overflow: hidden;
  opacity: 0;
  /* 中间镂空，高光只显示在圆角边框内。 */
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  pointer-events: none;
  animation: salon-border-fade 11800ms linear infinite;
  animation-play-state: paused;
}

.salon-card-border-light::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  padding-bottom: 200%;
  content: '';
  background: conic-gradient(from 0deg, rgba(235, 202, 133, 0) 0deg 285deg, rgba(235, 202, 133, 0.12) 305deg, rgba(245, 219, 158, 0.65) 330deg, #f8e2ad 346deg, #fff4d6 355deg, rgba(255, 244, 214, 0) 360deg);
  animation: salon-border-travel 11800ms linear infinite;
  animation-delay: inherit;
  animation-play-state: paused;
}

.salon-card-border-light--active,
.salon-card-border-light--active::before {
  animation-play-state: running;
}

@keyframes salon-border-travel {
  0% { transform: translate(-50%, -50%) rotate(95deg); }
  15.25%, 100% { transform: translate(-50%, -50%) rotate(295deg); }
}

@keyframes salon-border-fade {
  0%, 15.25%, 100% { opacity: 0; }
  1.22%, 13.73% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .salon-card-border-light { display: none; animation: none; }
  .salon-card-border-light::before { animation: none; }
}

.salon-head {
  display: flex;
  align-items: flex-start;
  min-height: 44rpx;
}

.salon-name {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  word-break: break-all;
  /* app.wxss 的全局 .salon-name 限高并裁剪溢出；店名在这里完整换行，不裁剪才能露出标签四周的阴影。 */
  max-height: none;
  overflow: visible;
}

.salon-rating {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  min-height: 44rpx;
  margin-left: 16rpx;
  color: #d06884;
  font-size: 34rpx;
  font-weight: 800;
  white-space: nowrap;
}

.salon-rating-value {
  line-height: 1;
}

/* 视觉对齐：五角星上尖下宽，视觉重心在高度约 55% 处，外框居中时看起来比数字低。
   向上挪 1.5rpx（约为星星显示高度的 5%），让星星和数字在视觉上居中对齐。 */
.salon-rating .star-icon {
  transform: translateY(-1.5rpx);
}

.star-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

/* 收藏按钮在卡片右下角（底部栏右端），垂直居中；点击区域比图标向外扩出 19rpx。
   margin-top 为（图标高度 + 上下内边距）的一半，保持垂直居中。 */
.favorite {
  position: absolute;
  top: 50%;
  right: -19rpx;
  margin-top: -38.25rpx;
  padding: 19rpx;
  font-size: 0;
}

.favorite image {
  display: block;
  width: 44rpx;
  height: 38.5rpx;
}

.salon-gallery {
  width: auto;
  height: 229.6rpx;
  margin: 26rpx -30.5rpx 0 0;
  white-space: nowrap;
}

.salon-image-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 306.6rpx;
  height: 229.6rpx;
  margin-right: 15.3rpx;
  overflow: hidden;
  border: 2rpx solid #e0e1e1;
  border-radius: 6rpx;
  background: #f7f4f2;
  vertical-align: top;
}

.salon-image-wrap:last-child {
  margin-right: 30.5rpx;
}

.salon-image-placeholder {
  color: #c8bbb4;
  font-size: 24.8rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.salon-image {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;
  width: 100%;
  min-width: 0;
  max-width: none;
  height: 100%;
  background: transparent;
}

/* 首页简介，最多两行。 */
.salon-desc {
  display: -webkit-box;
  margin-top: 22.3rpx;
  overflow: hidden;
  color: #333;
  font-size: 28rpx;
  line-height: 42rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.salon-info {
  margin-top: 18rpx;
  color: #333;
  font-size: 26rpx;
  line-height: 44rpx;
}

.salon-desc + .salon-info {
  margin-top: 22rpx;
}

.salon-info-row,
.salon-info-item {
  display: flex;
  align-items: center;
  min-width: 0;
}

.salon-info-item {
  flex: 0 0 auto;
}

.salon-info-item + .salon-info-item {
  margin-left: 23rpx;
}

/* 高光标签：紧跟在店名后面，随店名换行，只显示店铺的第一个标签。 */
.salon-name .salon-tag {
  display: inline-block;
  margin-left: 12rpx;
  /* 标签裁剪溢出，基线在盒子底边：下移 8rpx 后盒子中线与店名汉字的中线重合。 */
  vertical-align: -8rpx;
}

.salon-name .featured-badge {
  margin-left: 12rpx;
  vertical-align: middle;
}

.salon-tag {
  position: relative;
  box-sizing: border-box;
  max-width: calc(100% - 12rpx);
  padding: 2rpx 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.salon-tag::after {
  position: absolute;
  top: -50%;
  left: -45%;
  width: 30%;
  height: 200%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.78), transparent);
  content: '';
  opacity: 0;
  transform: skewX(-20deg);
  animation: salon-tag-shine 2.8s ease-in-out infinite;
  /* 只在可见卡片上播放，避免屏幕外的标签持续占用渲染。 */
  animation-play-state: paused;
}

.salon-card--visible .salon-tag::after {
  animation-play-state: running;
}

@media (prefers-reduced-motion: reduce) {
  .salon-tag::after { animation: none; }
}

.salon-tag-text {
  position: relative;
  z-index: 1;
  color: #ffe777;
  background: linear-gradient(110deg, #f3c94d 0%, #fff1a6 20%, #ffffea 40%, #f6d55c 57%, #fff9cf 76%, #e8b72f 100%);
  background-clip: text;
  text-shadow: 0 1rpx 2rpx rgba(67, 28, 82, 0.18);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.salon-tag-nature {
  background: linear-gradient(105deg, #56ab2f 0%, #a8e063 100%);
  box-shadow: 0 4rpx 10rpx rgba(87, 154, 42, 0.3);
}

.salon-tag-nature .salon-tag-text {
  color: #245524;
  background: none;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.32);
  -webkit-text-fill-color: #245524;
}

.salon-tag-neon {
  background: linear-gradient(105deg, #ff00cc 0%, #3333ff 100%);
  box-shadow: 0 4rpx 10rpx rgba(105, 33, 224, 0.3);
}

@keyframes salon-tag-shine {
  0% {
    opacity: 0;
    transform: translateX(0) skewX(-20deg);
  }

  10% {
    opacity: 1;
  }

  50% {
    opacity: 0.8;
    transform: translateX(500%) skewX(-20deg);
  }

  51%,
  100% {
    opacity: 0;
    transform: translateX(500%) skewX(-20deg);
  }
}

.salon-info-icon {
  width: 42rpx;
  height: 38rpx;
  flex: 0 0 42rpx;
  margin-right: 8.3rpx;
}

.distance {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.salon-cta {
  position: relative;
  height: 86.5rpx;
  margin-top: 19rpx;
  border-top: 2rpx solid #e0e1e1;
  color: #b43f58;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 84.6rpx;
  text-align: center;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 114rpx;
}

.load-more-dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.load-more-dot {
  width: 14rpx;
  height: 14rpx;
  background: #d06884;
  border-radius: 50%;
  animation: load-more-dot-wave 900ms ease-in-out infinite;
}

.load-more-dot:nth-child(2) {
  animation-delay: 120ms;
}

.load-more-dot:nth-child(3) {
  animation-delay: 240ms;
}

@keyframes load-more-dot-wave {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.45;
  }

  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .load-more-dot { animation: none; }
}

.new-user-gift {
  position: fixed;
  z-index: 20;
  right: 12px;
  bottom: calc(89px + env(safe-area-inset-bottom));
  width: 174px;
  height: 198px;
}

.new-user-gift-image {
  position: absolute;
  right: 0;
  bottom: 0;
  display: block;
  width: 158px;
  height: 158px;
  overflow: hidden;
  border-radius: 10px;
}

.new-user-gift-close-target {
  position: absolute;
  top: -5rpx;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
}

.new-user-gift-close {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #e2e2e2;
  color: #666;
  font-size: 20px;
  line-height: 28px;
  text-align: center;
}

.support-fab,
.back-to-top {
  position: fixed;
  z-index: 8;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  margin: 0;
  padding: 0;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
  opacity: 1;
  transition: transform 240ms ease-out, opacity 240ms ease-out;
}

.support-fab {
  bottom: calc(180px + env(safe-area-inset-bottom));
}

.back-to-top {
  bottom: calc(140px - 20rpx + env(safe-area-inset-bottom));
}

.support-fab image,
.back-to-top image {
  display: block;
  width: 68rpx;
  height: 68rpx;
}

.back-to-top image {
  width: 54rpx;
  height: 54rpx;
  transform: rotate(180deg);
}

.back-to-top-pressed {
  transform: scale(0.9);
  transition-duration: 120ms;
}

.support-fab-hidden {
  opacity: 0.333;
  pointer-events: none;
  transform: translateX(66.666%);
}

/* 加载占位卡片：沿用真实卡片的容器（salon-head / salon-info / salon-cta），尺寸与店名、标签、评分、
   简介、地址、评价与价格、底部操作对应，卡片高度由内容撑开，与真实卡片一致。 */
.home-skeleton-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.home-skeleton-name {
  flex: none;
  width: 170rpx;
  height: 30rpx;
  margin: 7rpx 0;
}

.home-skeleton-tag {
  flex: none;
  width: 200rpx;
  height: 38rpx;
  border-radius: 999rpx;
}

.home-skeleton-rating {
  width: 72rpx;
  height: 34rpx;
  margin: 5rpx 0;
}

/* 简介单行（行高 42rpx）。 */
.home-skeleton-desc-row {
  margin-top: 22.3rpx;
  padding: 7rpx 0;
}

.home-skeleton-desc {
  width: 46%;
  height: 28rpx;
  margin: 0;
}

