.home {
  min-height: 100vh;
  background: #fffdfb;
}

.appbar {
  padding: 0 28rpx 13rpx;
  background: #e8a2b0;
}

.appbar-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.location {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: calc(100% - 150rpx);
  height: 48rpx;
  color: #fff;
}

.top-icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  margin-right: 18rpx;
}

.location-text {
  min-width: 0;
  max-height: 48rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.arrow-icon {
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
  margin-left: 18rpx;
}

.message-btn {
  position: absolute;
  z-index: 0;
  right: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #fff;
}

.message-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.message-icon {
  width: 44rpx;
  height: 44rpx;
}

.message-dot {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #e8a2b0;
  border-radius: 50%;
  background: #ff3b30;
}

.search button::after {
  border: 0;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-top: 14rpx;
  padding: 0 8rpx 0 46rpx;
  border-radius: 999rpx;
  background: #fff;
}

.search input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #656565;
  font-size: 32rpx;
  font-weight: 700;
}

.search button {
  width: 90rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #e8a2b0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.suggestions {
  position: relative;
  z-index: 5;
  margin: 12rpx 20rpx 0;
  padding: 6rpx 16rpx;
  border: 1rpx solid #e8dcd0;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.suggestion {
  padding: 10rpx 0;
  border-top: 1rpx solid #f4e7df;
}

.suggestion:first-child {
  border-top: 0;
}

.suggestion-name {
  overflow: hidden;
  color: #5a5a5a;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: #999;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list {
  padding: 0;
}

.ad-link {
  display: block;
  height: 142rpx;
  margin: 20rpx 20rpx 0;
  overflow: hidden;
}

.ad-banner {
  width: 100%;
  height: 100%;
}

.list-title {
  margin: 22rpx 18rpx 24rpx;
  color: #5a5a5a;
  font-size: 34rpx;
  font-weight: 800;
}

.loading,
.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a8a8a;
}

.empty-title {
  color: #5a5a5a;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-sub {
  margin-top: 12rpx;
  color: #8a8a8a;
}

.retry {
  width: 100%;
  height: 53rpx;
  line-height: 53rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #d06884;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.salon-card {
  position: relative;
  display: flex;
  height: calc(220rpx + 5px);
  margin: 0 18rpx 14rpx;
  overflow: hidden;
  border: 1rpx solid #f0e4db;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(156, 114, 91, 0.12);
}

.salon-image {
  width: 270rpx;
  height: calc(220rpx + 5px);
  flex: 0 0 270rpx;
  background: #eee;
}

.salon-body {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 14rpx 8rpx 8rpx 12rpx;
}

.salon-head {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.salon-name {
  flex: 1;
  min-width: 0;
  max-height: 70rpx;
  overflow: hidden;
  color: #5a5a5a;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.salon-rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 0 0 auto;
  overflow: hidden;
  color: #ff9800;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: right;
  white-space: nowrap;
}

.star-icon {
  width: 25rpx;
  height: 25rpx;
}

.salon-desc {
  display: -webkit-box;
  height: 58rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #777;
  font-size: 30rpx;
  line-height: 32rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.salon-foot {
  position: absolute;
  right: 8rpx;
  bottom: 8px;
  left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.distance {
  min-width: 0;
  max-width: 280rpx;
  overflow: hidden;
  color: #d06884;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
}

.favorite image {
  width: 46rpx;
  height: 46rpx;
}

.load-more {
  padding: 20rpx 0 34rpx;
  color: #8a8a8a;
  font-size: 24rpx;
  text-align: center;
}
