<view class="home">
  <view class="appbar" style="padding-top: {{statusBarHeight}}px; min-height: {{appBarHeight}}px;">
    <view class="appbar-row" style="height: {{navBarHeight}}px;">
      <view class="location" style="max-width: calc(100% - {{menuButtonOffset}}px - 62rpx);" bindtap="openLocation">
        <image class="top-icon" mode="aspectFit" src="/assets/icons/location_on_outlined_ink.png" />
        <text class="location-text">{{locationText}}</text>
        <image class="arrow-icon" mode="aspectFit" src="/assets/icons/keyboard_arrow_down_ink.png" />
      </view>
      <view class="message-btn" style="margin-right: calc({{menuButtonOffset}}px + 5rpx);" bindtap="openMessages" role="button" aria-label="消息">
        <view class="message-wrap">
          <image class="message-icon" mode="aspectFit" src="/assets/icons/notifications_none_ink.png" />
          <view wx:if="{{unreadMessageCount}}" class="message-dot">{{unreadMessageCount > 99 ? '99+' : unreadMessageCount}}</view>
        </view>
      </view>
    </view>
    <view class="search">
      <input value="{{keyword}}" bindinput="onKeyword" bindconfirm="submitSearch" placeholder="按名称搜索沙龙..." />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="clearSearch" role="button" aria-label="清除搜索内容">
        <image mode="aspectFit" src="/assets/icons/close.png" />
      </view>
      <button hover-class="none" bindtap="submitSearch">搜索</button>
    </view>
  </view>

  <view wx:if="{{suggestions.length}}" class="suggestions">
    <view wx:for="{{suggestions}}" wx:key="id" class="suggestion" bindtap="chooseSuggestion" data-id="{{item.id}}" data-name="{{item.name}}">
      <view class="suggestion-name">{{item.name}}</view>
      <view class="suggestion-sub">{{item.addressText}}</view>
    </view>
  </view>

  <scroll-view id="home-list" scroll-y enhanced class="list" style="height: calc(100vh - {{appBarHeight}}px);" bindscroll="onListScroll" bindscrolltolower="loadMore" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh">
    <navigator wx:if="{{ad.enabled}}" class="ad-link" url="{{ad.link}}" hover-class="none" aria-label="查看广告详情">
      <image class="ad-banner" mode="aspectFill" src="{{ad.image}}" />
    </navigator>
    <view class="notice">
      <image class="notice-icon" mode="aspectFit" src="/assets/icons/campaign.png" />
      <view class="notice-window">
        <text class="notice-text">在服务过程中如果遇到强迫购买产品、升级项目、充值或办理会员卡等问题请第一时间向平台客服举报反馈！</text>
        <text class="notice-text" aria-hidden="true">在服务过程中如果遇到强迫购买产品、升级项目、充值或办理会员卡等问题请第一时间向平台客服举报反馈！</text>
      </view>
    </view>

    <coupon-tip tip-class="home-coupon-tip" />

    <view class="category-finder-title">按分类查找</view>
    <view class="category-finder" aria-label="按分类查找店铺">
      <view
        wx:for="{{salonCategories}}"
        wx:key="id"
        class="category-finder-item"
        bindtap="openSalonCategory"
        data-category="{{item.id}}"
        role="button"
        aria-label="查看{{item.label}}推广图片"
      >
        <image class="category-finder-image" mode="aspectFill" src="{{item.image}}" />
        <text class="category-finder-label">{{item.label}}</text>
        <view class="category-finder-arrow" aria-hidden="true"></view>
      </view>
    </view>

    <view class="salon-list-section">
      <view class="salon-list-heading">
        <view class="salon-list-title">附近店铺</view>
        <view class="salon-sort" role="tablist" aria-label="店铺排序">
          <view class="salon-sort-option {{salonSort === 'distance' ? 'salon-sort-active' : ''}}" catchtap="changeSalonSort" data-sort="distance" role="tab" aria-selected="{{salonSort === 'distance'}}">距离</view>
          <view class="salon-sort-option {{salonSort === 'rating' ? 'salon-sort-active' : ''}}" catchtap="changeSalonSort" data-sort="rating" role="tab" aria-selected="{{salonSort === 'rating'}}">评分</view>
        </view>
      </view>
      <view wx:if="{{locationFailed && !locatedOnce}}" class="location-fallback" bindtap="openLocation" role="button" aria-label="未获取到你的位置，当前展示默认城市的店铺，点击选择位置">
        <image class="location-fallback-icon" mode="aspectFit" src="/assets/icons/location_on.png" />
        <text class="location-fallback-text">未获取到你的位置，当前为默认城市店铺</text>
        <text class="location-fallback-action">选择位置</text>
      </view>
      <view wx:if="{{errorMessage}}" class="empty">
        <view class="empty-title">加载失败</view>
        <view class="empty-sub">{{errorMessage}}</view>
        <button class="retry" bindtap="loadSalons">重新加载</button>
      </view>
      <view wx:elif="{{searchKeyword && !salonCount}}" class="empty">
        <view class="empty-title">没有找到匹配的沙龙</view>
        <view class="empty-sub">换个名称试试看</view>
      </view>
      <view wx:elif="{{!loading && !salonCount}}" class="empty">
        <view class="empty-title">附近暂无沙龙请更换定位重新尝试</view>
      </view>

      <view wx:for="{{salonCards}}" wx:for-index="salonIndex" wx:key="cardKey" class="salon-card {{item.isPlaceholder ? 'salon-card--loading' : ''}} {{visibleSalonCards[salonIndex] ? 'salon-card--visible' : ''}}" bindtap="openDetail" data-card-index="{{salonIndex}}" data-id="{{item.id}}">
        <view class="salon-card-border-light {{visibleSalonCards[salonIndex] ? 'salon-card-border-light--active' : ''}}" style="animation-delay: {{salonIndex * 70 + 560}}ms;" aria-hidden="true"></view>
        <!-- 右上角评分：暂无评分的店铺暂时显示为 5，真实评分数据不变；恢复时改回只显示 ratingText，并让星标只在有评分时出现。 -->
        <view class="salon-head">
          <!-- 加载占位：店名与标签、右上角评分的位置。 -->
          <block wx:if="{{item.isPlaceholder}}">
            <view class="salon-name home-skeleton-head" aria-hidden="true"><view class="skeleton-line home-skeleton-name"></view><view class="skeleton-block home-skeleton-tag"></view></view>
            <view class="salon-rating" aria-hidden="true"><view class="skeleton-block home-skeleton-rating"></view></view>
          </block>
          <view wx:if="{{!item.isPlaceholder}}" class="salon-name">
            <text>{{item.nameText}}</text><view wx:if="{{item.tags.length}}" class="salon-tag {{item.tags[0].colorClass}}"><text class="salon-tag-text">{{item.tags[0].text}}</text></view>
            <view wx:if="{{item.isFeatured}}" class="featured-badge"><text>靓丝精选</text></view>
          </view>
          <view wx:if="{{!item.isPlaceholder}}" class="salon-rating">
            <image class="star-icon rating-star" mode="aspectFit" src="/assets/icons/star_gold.png" />
            <text class="salon-rating-value">{{item.hasRating ? item.ratingText : '5'}}</text>
          </view>
        </view>
        <scroll-view class="salon-gallery" scroll-x enhanced show-scrollbar="{{false}}">
          <block wx:if="{{item.isPlaceholder}}">
            <view class="salon-image-wrap"><text class="salon-image-placeholder" aria-hidden="true">靓丝美约</text></view>
            <view class="salon-image-wrap"><text class="salon-image-placeholder" aria-hidden="true">靓丝美约</text></view>
            <view class="salon-image-wrap"><text class="salon-image-placeholder" aria-hidden="true">靓丝美约</text></view>
          </block>
          <block wx:else>
            <view wx:for="{{item.images}}" wx:for-item="image" wx:for-index="imageIndex" wx:key="*this" class="salon-image-wrap">
              <text class="salon-image-placeholder" aria-hidden="true">靓丝美约</text>
              <image wx:if="{{image}}" class="salon-image" mode="aspectFill"
                src="{{image}}" webp="{{true}}" lazy-load binderror="onSalonImageError"
                data-card-index="{{salonIndex}}" data-image-index="{{imageIndex}}" data-src="{{image}}" />
            </view>
          </block>
        </scroll-view>
        <block wx:if="{{!item.isPlaceholder}}">
          <view wx:if="{{item.introText}}" class="salon-desc">{{item.introText}}</view>
          <view class="salon-info">
            <view wx:if="{{item.distanceText || item.businessDistrict || item.addressText}}" class="salon-info-row">
              <image class="salon-info-icon" mode="aspectFit" src="/assets/icons/location_on_gray.svg" />
              <view class="distance">{{item.distanceText}}<text wx:if="{{item.businessDistrict}}">{{item.distanceText ? ' · ' : ''}}{{item.businessDistrict}}</text><text wx:if="{{item.addressText}}">{{item.distanceText || item.businessDistrict ? ' · ' : ''}}{{item.addressText}}</text></view>
            </view>
            <view class="salon-info-row">
              <view class="salon-info-item">
                <image class="salon-info-icon" mode="aspectFit" src="/assets/icons/chat_bubble_gray.svg" />
                <text>{{item.reviewCountText}}</text>
              </view>
              <view wx:if="{{item.cutPriceText}}" class="salon-info-item">
                <image class="salon-info-icon" mode="aspectFit" src="/assets/icons/yen_gray.svg" />
                <text>{{item.cutPriceText}}</text>
              </view>
            </view>
          </view>
          <view class="salon-cta">
            <text>查看店铺详情</text>
            <view class="favorite" catchtap="toggleFavorite" data-id="{{item.id}}" role="button" aria-label="{{item.isFavorite ? '取消收藏' : '收藏'}}">
              <image mode="aspectFit" src="{{item.isFavorite ? '/assets/icons/favorite_pink.svg' : '/assets/icons/favorite_border_ink.svg'}}" />
            </view>
          </view>
        </block>
        <!-- 加载占位：简介、地址、评价与价格、底部操作栏，位置与上面的真实内容一致。 -->
        <block wx:else>
          <view class="home-skeleton-desc-row" aria-hidden="true"><view class="skeleton-line home-skeleton-desc"></view></view>
          <view class="salon-info" aria-hidden="true">
            <view class="salon-info-row home-skeleton-row"><view class="skeleton-block home-skeleton-icon"></view><view class="skeleton-line home-skeleton-address"></view></view>
            <view class="salon-info-row home-skeleton-row">
              <view class="skeleton-block home-skeleton-icon"></view><view class="skeleton-line home-skeleton-reviews"></view>
              <view class="skeleton-block home-skeleton-icon"></view><view class="skeleton-line home-skeleton-price"></view>
            </view>
          </view>
          <view class="salon-cta home-skeleton-cta-row" aria-hidden="true">
            <view class="skeleton-line home-skeleton-cta"></view>
            <view class="favorite"><view class="skeleton-block home-skeleton-heart"></view></view>
          </view>
        </block>
      </view>

      <view wx:if="{{hasMoreSalons || loadingMore}}" class="load-more">
        <view wx:if="{{loadingMore}}" class="load-more-dots" role="status" aria-label="正在加载更多店铺">
          <view class="load-more-dot"></view>
          <view class="load-more-dot"></view>
          <view class="load-more-dot"></view>
        </view>
      </view>
    </view>
    <view class="tabbar-spacer" aria-hidden="true"></view>
  </scroll-view>

  <view wx:if="{{newUserGiftVisible}}" class="new-user-gift">
    <image
      class="new-user-gift-image"
      mode="aspectFill"
      src="{{newUserGiftImage}}"
      catchtap="claimNewUserGift"
      aria-label="领取新人礼包"
    />
    <view
      class="new-user-gift-close-target"
      catchtap="dismissNewUserGift"
      aria-label="关闭新人礼包推广图"
    >
      <view class="new-user-gift-close">×</view>
    </view>
  </view>

  <view class="support-fab {{supportHidden ? 'support-fab-hidden' : ''}}" hover-class="none" bindtap="openSupport" role="button" aria-label="平台客服">
    <image mode="aspectFit" src="/assets/icons/support_agent_muted.png" />
  </view>
  <view wx:if="{{showBackToTop}}" class="back-to-top {{supportHidden ? 'support-fab-hidden' : ''}}" hover-class="back-to-top-pressed" hover-stay-time="100" bindtap="scrollToTop" role="button" aria-label="返回顶部">
    <image mode="aspectFit" src="/assets/icons/keyboard_arrow_down_thin.svg" />
  </view>
</view>
