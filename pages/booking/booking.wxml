<import src="/styles/service-card-skeleton.wxml" />
<!-- 加载占位：沿用预约页真实区块的类名和尺寸，标题和分类名直接显示真实文字。 -->
<view wx:if="{{loading}}" class="page booking" role="status" aria-label="正在加载预约选项">
  <view class="hint">请完成以下预约选项</view>
  <view class="block-title">选择服务项目</view>
  <view class="service-tabs">
    <view wx:for="{{serviceTabs}}" wx:key="id" class="service-tab">{{item.label}}</view>
  </view>
  <view class="service-count"><view class="skeleton-line booking-skeleton-count"></view></view>
  <block wx:for="{{[0, 1]}}" wx:key="*this"><template is="service-card-skeleton" /></block>
  <view class="block-title">选择理发师</view>
  <view class="staff-list">
    <view wx:for="{{[0, 1]}}" wx:key="*this" class="staff-option">
      <view class="staff-img skeleton-block skeleton-flat"></view>
      <view class="staff-copy">
        <view class="skeleton-line booking-skeleton-staff-name"></view>
        <view class="skeleton-line booking-skeleton-staff-role"></view>
        <view class="skeleton-line booking-skeleton-staff-bio"></view>
      </view>
    </view>
  </view>
  <view class="block-title">选择预约日期</view>
  <view class="dates">
    <view wx:for="{{[0, 1, 2, 3, 4, 5, 6]}}" wx:key="*this" class="date skeleton-block"></view>
  </view>
  <view class="block-title">可用时间段</view>
  <view class="chips">
    <view wx:for="{{[0, 1, 2, 3, 4, 5, 6, 7]}}" wx:key="*this" class="chip skeleton-block"></view>
  </view>
</view>
<view wx:elif="{{errorMessage}}" class="page-error" role="alert">
  <view class="page-error-title">店铺加载失败</view>
  <view class="page-error-sub">{{errorMessage}}</view>
  <button class="primary-btn page-error-retry" bindtap="retryLoad">重新加载</button>
</view>
<view wx:else class="page booking">
  <view class="hint">请完成以下预约选项</view>
  <view class="block-title">选择服务项目</view>
  <view class="service-tabs" role="tablist">
    <view wx:for="{{serviceTabs}}" wx:key="id" class="service-tab {{item.className}}" bindtap="selectServiceCategory" data-category="{{item.id}}" role="tab" aria-selected="{{item.className == 'active'}}">{{item.label}}</view>
    <view class="service-tab-slider {{activeServiceCategory}}"></view>
  </view>
  <view class="service-count">共<text class="service-count-number">{{serviceOptions.length}}</text>个服务</view>
  <view wx:if="{{!serviceOptions.length}}" class="service-empty">该分类暂无服务</view>
  <view wx:for="{{serviceOptions}}" wx:key="id" class="service-card service-option {{item.className}}" bindtap="selectService" data-id="{{item.id}}" aria-role="button" aria-label="选择套餐：{{item.name}}" aria-pressed="{{item.className == 'active-card'}}">
    <view class="service-image-wrap">
      <image class="service-image" mode="aspectFill" src="{{item.imageUrl}}" lazy-load />
    </view>
    <view class="service-main">
      <view class="service-copy">
        <view class="service-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="service-tag">{{tag}}</text>
        </view>
        <view class="service-name">{{item.name}}</view>
        <view class="service-note">{{item.noteText}}</view>
      </view>
      <view class="service-meta">
        <service-price class="service-price-slot" price-fen="{{item.priceFen}}" discount-tenths="{{item.discountTenths}}" original-price-fen="{{item.originalPriceFen}}" />
        <view class="service-duration">{{item.durationText}}</view>
      </view>
    </view>
    <view class="check">
      <image class="check-img check-gray" mode="aspectFit" src="/assets/icons/check_circle_light_gray.png" />
      <image class="check-img check-pink" mode="aspectFit" src="/assets/icons/check_circle_pink.png" />
    </view>
  </view>

  <view class="block-title">选择理发师</view>
  <view class="staff-list">
    <view wx:for="{{staffOptions}}" wx:key="id" class="staff-option {{item.className}}" bindtap="selectStaff" data-id="{{item.id}}" aria-role="button" aria-disabled="{{item.disabled}}">
      <view wx:if="{{item.isNoPreference}}" class="staff-img no-preference">
        <image class="no-preference-img" mode="aspectFill" src="/assets/icons/who.png" />
      </view>
      <image wx:else class="staff-img" mode="aspectFill" src="{{item.imageUrl}}" />
      <view class="staff-copy">
        <view class="staff-head">
          <view class="staff-name">{{item.name}}</view>
          <view wx:if="{{item.extraServiceFeeText}}" class="fee">+{{item.extraServiceFeeText}}</view>
        </view>
        <view wx:if="{{!item.isNoPreference}}" class="staff-role">{{item.role}}{{item.experience ? '（' + item.experience + '）' : ''}}</view>
        <view wx:if="{{item.bio}}" class="staff-bio">{{item.bio}}</view>
      </view>
      <view class="check">
        <image class="check-img check-gray" mode="aspectFit" src="/assets/icons/check_circle_light_gray.png" />
        <image class="check-img check-pink" mode="aspectFit" src="/assets/icons/check_circle_pink.png" />
      </view>
    </view>
  </view>

  <view class="block-title">选择预约日期</view>
  <scroll-view scroll-x class="dates">
    <view wx:for="{{dates}}" wx:key="value" class="date {{item.className}}" bindtap="selectDate" data-value="{{item.value}}" data-disabled="{{item.isDisabled}}">
      <view class="date-week {{item.isRelativeDate ? 'relative' : ''}}">{{item.label}}</view>
      <view class="date-day">{{item.day}}</view>
      <view wx:if="{{item.isClosed}}" class="date-rest">休息日</view>
    </view>
  </scroll-view>

  <view class="block-title">可用时间段</view>
  <view class="slots-panel {{slotsLoading ? 'loading' : ''}} {{slotsAnimating ? 'animating' : ''}}">
    <view wx:if="{{slotsAnimating}}" class="slots-layer slots-previous" bindanimationend="finishSlotAnimation">
      <view class="chips">
        <view wx:for="{{previousSlotOptions}}" wx:key="startTime" class="chip {{item.className}}">{{item.time}}</view>
      </view>
    </view>
    <view class="slots-layer slots-current {{slotsAnimating ? 'entering' : ''}}">
      <view wx:if="{{slotErrorMessage}}" class="slot-state retry" bindtap="loadSlots" role="button" aria-label="重新加载时间段">加载失败，点击重试</view>
      <view wx:elif="{{!slotOptions.length && !slotsLoading}}" class="slot-state">暂无可用时间段</view>
      <view wx:else class="chips">
        <view wx:for="{{slotOptions}}" wx:key="startTime" class="chip {{item.className}}" bindtap="selectTime" data-time="{{item.time}}" data-available="{{item.isAvailable}}">
          {{item.time}}
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="primary-btn submit" disabled="{{!canSubmit}}" loading="{{submitting}}" bindtap="submit">{{submitText}}</button>
  </view>
</view>
