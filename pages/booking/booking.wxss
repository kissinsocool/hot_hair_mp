.booking {
  padding: 18rpx 16rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #fdfbf9;
}

.hint {
  color: #8a8a8a;
  font-size: 37.33rpx;
  line-height: 50.67rpx;
}

.block-title {
  margin: 44rpx 0 24rpx;
  color: #5a5a5a;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.staff-list {
  display: block;
}

.staff-option {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 248rpx;
  margin-bottom: 12rpx;
  padding: 0 46rpx 0 0;
  border: 1rpx solid #e8dcd0;
  border-radius: 0;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.02);
}

.staff-img,
.staff-placeholder {
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 248rpx;
  background: #eee;
}

.staff-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(232, 162, 176, 0.12);
  color: #d06884;
  font-size: 72rpx;
  font-weight: 800;
}

.staff-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  padding: 14rpx 0;
}

.staff-head {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 8rpx;
}

.staff-name {
  flex: 0 1 auto;
  min-width: 0;
  color: #5a5a5a;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 50.67rpx;
}

.fee {
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  background: #000;
  color: #d4af37;
  font-size: 26.67rpx;
  font-weight: 800;
}

.staff-role {
  margin-top: 6rpx;
  color: #777;
  font-size: 32rpx;
  line-height: 42.67rpx;
}

.staff-bio,
.service-note {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #5a5a5a;
  font-size: 30.67rpx;
  line-height: 41.33rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 18rpx;
}

.chip,
.date {
  min-width: 82rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #e8dcd0;
  border-radius: 8rpx;
  background: #fff;
  text-align: center;
}

.chip {
  width: 146rpx;
  height: 58rpx;
  min-width: 0;
  padding: 0;
  border-color: #cbc2d4;
  border-radius: 14rpx;
  background: #fff8ff;
  color: #5a5a5a;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 58rpx;
}

.active {
  border-color: #d06884;
  background: #d06884;
  color: #fff;
}

.staff-option.active {
  background: #fff;
  color: #5a5a5a;
}

.disabled {
  border-color: #b8b8b8;
  color: #cfcfcf;
  background: #e5e5e5;
}

.option {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  font-weight: 700;
}

.service-option {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 144rpx;
  margin-bottom: 10rpx;
  padding: 10rpx 54rpx 10rpx 18rpx;
  border: 1rpx solid #e8dcd0;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.015);
}

.service-img {
  flex: 0 0 114.67rpx;
  width: 114.67rpx;
  height: 114.67rpx;
  border-radius: 8rpx;
  background: #eee;
}

.service-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.service-tag {
  padding: 3rpx 12rpx;
  background: #fde4eb;
  color: #d06884;
  font-size: 25rpx;
  line-height: 32rpx;
}

.service-name {
  color: #5a5a5a;
  font-size: 37.33rpx;
  font-weight: 600;
  line-height: 45.33rpx;
}

.service-duration {
  margin-top: 4rpx;
  color: #999;
  font-size: 28rpx;
  line-height: 36rpx;
}

.service-side {
  position: absolute;
  top: 15rpx;
  right: 16rpx;
  height: 42.67rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.active-card {
  border-color: #d06884;
}

.check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 42.67rpx;
  height: 42.67rpx;
}

.check-img {
  position: absolute;
  inset: 0;
  width: 42.67rpx;
  height: 42.67rpx;
}

.service-side .check {
  position: relative;
  top: auto;
  right: auto;
  flex: 0 0 42.67rpx;
}

.check-pink {
  opacity: 0;
}

.active .check-gray,
.active-card .check-gray {
  opacity: 0;
}

.active .check-pink,
.active-card .check-pink {
  opacity: 1;
}

.price {
  color: #d06884;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42.67rpx;
}

.dates {
  white-space: nowrap;
}

.date {
  display: inline-block;
  width: 13%;
  height: 94px;
  min-width: 0;
  margin-right: 1%;
  padding: 20px 0 0;
  border: 1px solid #eadbd2;
  border-radius: 12px;
  color: #969696;
  font-size: 16px;
  font-weight: 400;
  line-height: 20px;
  vertical-align: top;
}

.date view:last-child {
  margin-top: 7px;
  color: #575757;
  font-size: 20px;
  font-weight: 700;
  line-height: 27px;
}

.date.active {
  border-color: #d06884;
  background: #d06884;
  color: #fff;
}

.date.active view:last-child {
  color: #fff;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.submit {
  width: 100% !important;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.submit[disabled] {
  background: #dddddf;
  opacity: 1;
}
