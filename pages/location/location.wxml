<view class="page">
  <view class="card panel">
    <view class="section-title">当前位置</view>
    <view class="muted">{{addressText}}</view>
    <button class="primary-btn action" loading="{{locating}}" bindtap="locate">使用当前位置</button>
  </view>
  <view wx:if="{{false}}" class="card panel">
    <view class="section-title">手动输入</view>
    <input value="{{manual}}" bindinput="onManual" placeholder="输入商圈、地铁站或地址" />
    <button class="ghost-btn action" bindtap="useManual">使用此地址</button>
  </view>
</view>
