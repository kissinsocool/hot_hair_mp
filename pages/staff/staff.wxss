.staff-page {
  padding-bottom: 140rpx;
}

.profile {
  padding: 30rpx 20rpx;
  background: #fff;
  text-align: center;
}

.avatar {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: #e8dcd0;
}

.name {
  margin-top: 40rpx;
  color: #d06884;
  font-size: 48rpx;
  font-weight: 800;
}

.role {
  margin: 14rpx 0;
  color: #5a5a5a;
}

.rating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 24rpx 0;
}

.rating > text {
  color: #f2a51f;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #f2a51f;
  line-height: 1;
}

.stars image {
  width: 44rpx;
  height: 44rpx;
}

.review-count {
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 40rpx;
}

.desc {
  color: #5a5a5a;
  line-height: 1.6;
}

.review {
  padding: 18rpx 0;
  border-top: 1rpx solid #f4e7df;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-image {
  width: 128rpx;
  height: 152rpx;
  border-radius: 4rpx;
  background: #eee;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-weight: 800;
}

.review-stars {
  display: flex;
  align-items: center;
  gap: 3rpx;
}

.review-star-icon {
  width: 27.5rpx;
  height: 27.5rpx;
}

.bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.bar .primary-btn {
  height: 82rpx;
  line-height: 82rpx;
  width: 100% !important;
  margin: 0;
  font-size: 36rpx;
  font-weight: 700;
}
