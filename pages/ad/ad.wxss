.ad-page {
  min-height: 100vh;
  background: #fff;
}

.hero {
  display: block;
  width: 100%;
  height: 150rpx;
}

.content {
  padding: 48rpx 32rpx;
}

.eyebrow {
  color: #168fe0;
  font-size: 28rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  color: #424242;
  font-size: 48rpx;
  font-weight: 800;
}

.desc {
  margin-top: 24rpx;
  color: #777;
  font-size: 30rpx;
  line-height: 1.7;
}

.card {
  margin-top: 44rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #f4fbff;
  color: #666;
  font-size: 28rpx;
  line-height: 2;
}

.card-title {
  margin-bottom: 8rpx;
  color: #424242;
  font-size: 32rpx;
  font-weight: 800;
}
