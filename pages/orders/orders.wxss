.orders-page {
  height: 100vh;
  overflow: hidden;
  background: #f3f2f0;
}

.orders-appbar {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 28rpx 24rpx;
  border-bottom: 1rpx solid #b2b2b2;
  background: #ffffff;
  box-sizing: border-box;
}

.orders-appbar-spacer {
  flex: 0 0 auto;
}

.orders-title {
  position: absolute;
  left: 50%;
  display: flex;
  align-items: center;
  transform: translateX(-50%);
  color: #3a202c;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
}

.orders-bell {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-right: 194rpx;
}

.orders-bell-icon {
  width: 44rpx;
  height: 44rpx;
}

.orders-bell-dot {
  position: absolute;
  top: -17rpx;
  left: 30rpx;
  box-sizing: border-box;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
  text-align: center;
  white-space: nowrap;
}

.orders-list {
  box-sizing: border-box;
}

/* 内边距放在滚动容器内部，避免 scroll-view 的裁剪层切掉卡片阴影。 */
.orders-list-inner {
  padding: 24rpx 32rpx 32rpx;
}

.orders-list-heading {
  margin-bottom: 32rpx;
}

.orders-list-title {
  color: #554a46;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.orders-list-note {
  margin-top: 32rpx;
  color: #666;
  font-size: 21rpx;
  line-height: 31rpx;
}

.orders-list-note-mark {
  margin-right: 6rpx;
  font-size: 25rpx;
}

.list-footer {
  padding: 24rpx 0 36rpx;
  color: #aaa;
  font-size: 24rpx;
  text-align: center;
}

.order {
  margin-bottom: 34rpx;
  padding: 30rpx;
  border: 0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(67, 57, 54, 0.06), 0 4rpx 28rpx rgba(67, 57, 54, 0.11);
  letter-spacing: 0.5rpx;
}

.order-heading {
  display: flex;
  align-items: center;
  gap: 23rpx;
  margin-bottom: 23rpx;
}

.status {
  flex: 0 0 191rpx;
  padding: 0 8rpx;
  color: #fff;
  background: #aaa;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 38rpx;
  text-align: center;
}

.status-accepted { background: #b73556; color: #fff; }
.status-red { background: #b85f63; }
.status-orange { background: #bd9364; }
.status-completed,
.status-canceled,
.status-cancelled { background: #b2b2b2; }

.arrival-time {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 38rpx;
  white-space: nowrap;
}

.salon-summary {
  display: flex;
  align-items: flex-start;
  gap: 23rpx;
}

.salon-cover {
  flex: 0 0 191rpx;
  height: 143rpx;
  overflow: hidden;
  border: 2rpx solid #e1e1df;
  border-radius: 7rpx;
  box-sizing: border-box;
  background: #f1efed;
}

.salon-image,
.salon-image-placeholder {
  width: 100%;
  height: 100%;
}

.salon-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.salon-image-placeholder image { width: 64rpx; height: 64rpx; opacity: 0.45; }

.salon-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.salon-category {
  align-self: flex-start;
  margin-bottom: 12rpx;
  padding: 0 9rpx;
  background: #f8dce1;
  color: #a9445e;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.salon-name,
.salon-description,
.service-name,
.coupon-discount {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.salon-name { color: #333; font-size: 25rpx; font-weight: 600; line-height: 36rpx; }
.salon-description { color: #6f6f6f; font-size: 23rpx; font-weight: 400; line-height: 36rpx; }

.service-summary {
  margin-top: 25rpx;
  padding: 19rpx 26rpx;
  border-radius: 8rpx;
  background: #f6f6f6;
}

.service-label { color: #635757; font-size: 21rpx; font-weight: 600; line-height: 34rpx; }
.service-name { color: #333; font-size: 25rpx; font-weight: 400; line-height: 36rpx; }
.coupon-discount { margin-top: 4rpx; color: #a9445e; font-size: 23rpx; line-height: 32rpx; }

.actions {
  display: flex;
  flex-wrap: nowrap;
  justify-content: flex-end;
  gap: 15rpx;
  margin-top: 24rpx;
}

.order-button {
  flex: 1 1 0;
  min-width: 0;
  width: auto !important;
  height: 84rpx;
  padding: 0 8rpx;
  border: 2rpx solid #e2e2e2;
  border-radius: 16rpx;
  background: #fff;
  color: #4c4546;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 80rpx;
}

/* 覆盖原生 button:not([size=mini]) 的自动左右外边距。 */
.actions .order-button { margin: 0; }

.review-button { border-color: #e2e2e2; background: #fff; color: #a9445e; }
.rebook-button { border-color: #c56f85; background: #c56f85; color: #fff; font-weight: 600; }
.cancel-button { color: #5f5758; }
.actions-single .order-button { flex: 0 1 260rpx; }
.disabled-btn { color: #999; background: #fafafa; }

.empty-icon {
  width: 112rpx;
  height: 112rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #5a5a5a;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-sub {
  margin-top: 12rpx;
  color: #8a8a8a;
  font-size: 28rpx;
}
