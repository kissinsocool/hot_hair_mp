<view class="orders-page">
  <view class="orders-appbar" style="padding-top: {{statusBarHeight}}px; height: {{appBarHeight}}px;">
    <view class="orders-title">我的订单</view>
    <view class="orders-bell" style="margin-right: calc({{menuButtonOffset}}px + 5rpx);" bindtap="openMessages">
      <image class="orders-bell-icon" mode="aspectFit" src="/assets/icons/notifications_none.png" />
      <view wx:if="{{unreadMessageCount}}" class="orders-bell-dot">{{unreadMessageCount > 99 ? '99+' : unreadMessageCount}}</view>
    </view>
  </view>
  <view class="orders-appbar-spacer" style="height: {{appBarHeight}}px;"></view>

  <scroll-view
    scroll-y
    class="orders-list"
    style="height: calc(100vh - {{appBarHeight}}px - 54px - env(safe-area-inset-bottom));"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="refresh"
    bindscrolltolower="loadMore"
    lower-threshold="120"
  >
    <view class="orders-list-inner">
      <view wx:if="{{!loggedIn}}"></view>
      <view wx:elif="{{loading && !orders.length}}" class="empty">正在加载...</view>
      <view wx:elif="{{!orders.length}}" class="empty">
        <image class="empty-icon" mode="aspectFit" src="/assets/icons/receipt_long_outline.png" />
        <view class="empty-title">暂无订单</view>
        <view class="empty-sub">完成预约后，订单会显示在这里</view>
      </view>
      <view wx:for="{{orders}}" wx:key="id" class="card order order-{{item.status}}" bindtap="openOrderDetail" data-id="{{item.id}}">
        <view class="order-heading">
          <view class="status {{item.statusClass}} status-{{item.status}}">{{item.cardStatusLabel}}</view>
          <view class="arrival-time">{{item.cardStartTimeText}}</view>
        </view>
        <view class="salon-summary">
          <view class="salon-cover">
            <image wx:if="{{item.salonImageUrl}}" class="salon-image" src="{{item.salonImageUrl}}" mode="aspectFill" binderror="onSalonImageError" data-id="{{item.id}}" />
            <view wx:else class="salon-image-placeholder"><image src="/assets/icons/storefront.png" mode="aspectFit" /></view>
          </view>
          <view class="salon-info">
            <text class="salon-category">美发沙龙</text>
            <view class="salon-name">{{item.salonName}}</view>
            <view class="salon-description">{{item.salonDescription || '暂无简介'}}</view>
          </view>
        </view>
        <view class="service-summary">
          <view class="service-label">预约套餐</view>
          <view class="service-name">{{item.serviceName}}{{item.serviceDescription ? ' · ' + item.serviceDescription : ''}}</view>
          <view wx:if="{{item.hasCouponDiscount}}" class="coupon-discount">{{item.couponText}}</view>
        </view>
        <view wx:if="{{item.canReview || item.canRebook || item.canCancel}}" class="actions {{(item.canReview + item.canRebook + item.canCancel) === 1 ? 'actions-single' : ''}}">
          <button wx:if="{{item.canReview}}" class="order-button review-button{{item.reviewButtonClass}}" catchtap="review" data-id="{{item.id}}" data-type="review" data-disabled="{{item.reviewed}}" aria-disabled="{{item.reviewed}}">{{item.reviewButtonText}}</button>
          <button wx:if="{{item.canRebook}}" class="order-button rebook-button" catchtap="rebook" data-id="{{item.id}}">再次预约</button>
          <button wx:if="{{item.canCancel}}" class="order-button cancel-button" catchtap="cancel" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
      <view wx:if="{{loadingMoreOrders}}" class="list-footer">正在加载更多...</view>
      <view wx:elif="{{orders.length >= 20 && !hasMoreOrders}}" class="list-footer">没有更多订单了</view>
    </view>
  </scroll-view>
</view>
