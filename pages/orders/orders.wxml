<view class="orders-page">
  <view class="orders-appbar" style="padding-top: {{statusBarHeight}}px; height: {{appBarHeight}}px;">
    <view class="orders-title">我的订单</view>
    <view class="orders-bell" style="margin-right: {{menuButtonOffset}}px;" bindtap="openMessages">
      <image class="orders-bell-icon" mode="aspectFit" src="/assets/icons/notifications_none.png" />
      <view wx:if="{{hasUnreadMessages}}" class="orders-bell-dot"></view>
    </view>
  </view>
  <view class="orders-appbar-spacer" style="height: {{appBarHeight}}px;"></view>

  <scroll-view
    scroll-y
    class="orders-list"
    style="height: calc(100vh - {{appBarHeight}}px - 80px - env(safe-area-inset-bottom));"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="refresh"
  >
    <view wx:if="{{!loggedIn}}"></view>
    <view wx:elif="{{loading && !orders.length}}" class="empty">正在加载...</view>
    <view wx:elif="{{!orders.length}}" class="empty">
      <image class="empty-icon" mode="aspectFit" src="/assets/icons/receipt_long_outlined.png" />
      <view class="empty-title">暂无订单</view>
      <view class="empty-sub">完成预约后，订单会显示在这里</view>
    </view>
    <view wx:for="{{orders}}" wx:key="id" class="card order" bindtap="openOrderSalon" data-salon-id="{{item.salonId}}">
      <view class="top">
        <view class="name">{{item.serviceName}}</view>
        <view class="status {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="muted"><text class="order-label">订单编号:</text>{{item.orderNo}}</view>
      <view class="muted"><text class="order-label">商家名称:</text>{{item.salonName}}</view>
      <view class="time"><text class="order-label">到店时间:</text>{{item.startTimeText}}</view>
      <view class="muted"><text class="order-label">理发师:</text>{{item.staffName}}</view>
      <view class="muted"><text class="order-label">下单时间:</text>{{item.createdTimeText}}</view>
      <view wx:if="{{item.hasCouponDiscount}}" class="muted coupon-discount"><text class="order-label">优惠券:</text>{{item.couponText}}</view>
      <view class="actions {{item.canCancel && !item.canReview && !item.canComplain ? 'single' : ''}}">
        <button wx:if="{{item.canCancel}}" class="cancel danger" catchtap="cancel" data-id="{{item.id}}"><image class="btn-icon" mode="aspectFit" src="/assets/icons/cancel.png" />取消订单</button>
        <button wx:if="{{item.canReview}}" class="cancel{{item.reviewButtonClass}}" catchtap="review" data-id="{{item.id}}" data-type="review" data-disabled="{{item.reviewed}}"><image class="btn-icon" mode="aspectFit" src="{{item.reviewed ? '/assets/icons/check_circle.png' : '/assets/icons/rate_review_outlined.png'}}" />{{item.reviewButtonText}}</button>
        <button wx:if="{{item.canComplain}}" class="cancel danger{{item.complaintButtonClass}}" catchtap="review" data-id="{{item.id}}" data-type="complaint" data-disabled="{{item.complained}}"><image class="btn-icon" mode="aspectFit" src="{{item.complained ? '/assets/icons/check_circle.png' : '/assets/icons/report_problem_outlined.png'}}" />{{item.complaintButtonText}}</button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{sheetVisible}}" class="sheet-mask" catchtap="closeSheet"></view>
  <view wx:if="{{sheetVisible}}" class="sheet">
    <view class="sheet-close" catchtap="closeSheet"><image mode="aspectFit" src="/assets/icons/close.png" /></view>
    <scroll-view scroll-y class="sheet-body">
      <view class="sheet-head">
        <view class="sheet-title">{{sheetType == 'review' ? '评价晒单' : '投诉'}}</view>
      </view>
      <view class="sheet-info"><image class="icon-img" mode="aspectFit" src="/assets/icons/storefront_outlined.png" />{{sheetOrder.salonName}}</view>
      <view class="sheet-info"><image class="icon-img" mode="aspectFit" src="/assets/icons/content_cut.png" />{{sheetOrder.serviceName}}</view>

      <view wx:if="{{sheetType == 'review'}}" class="rating-block">
        <view class="field-title">选择星级</view>
        <view class="stars-row">
          <view wx:for="{{sheetStars}}" wx:key="value" class="star-btn {{item.selected ? 'active' : ''}}" data-value="{{item.value}}" catchtap="chooseRating">
            <image mode="aspectFit" src="{{item.icon}}" />
          </view>
        </view>
      </view>

      <view class="textarea-wrap">
        <textarea class="sheet-textarea" placeholder-class="sheet-placeholder" value="{{sheetContent}}" bindinput="onSheetContent" maxlength="{{sheetType == 'review' ? 200 : 300}}" placeholder="{{sheetType == 'review' ? '分享这次服务体验...' : '请描述遇到的问题...'}}" />
        <view class="textarea-count">{{sheetContent.length}}/{{sheetType == 'review' ? 200 : 300}}</view>
      </view>

      <view class="upload-row">
        <view class="field-title">上传图片 {{sheetImages.length}}/5</view>
        <button class="pick-btn" catchtap="pickImages"><image class="btn-icon" mode="aspectFit" src="/assets/icons/add_photo_alternate_outlined.png" />选择图片</button>
      </view>
      <view wx:if="{{sheetImages.length}}" class="picked-list">
        <view wx:for="{{sheetImages}}" wx:for-index="index" wx:key="tempPath" class="picked">
          <image mode="aspectFill" src="{{item.tempPath}}" />
          <view class="remove" data-index="{{index}}" catchtap="removeImage"><image mode="aspectFit" src="/assets/icons/close.png" /></view>
        </view>
      </view>
    </scroll-view>
    <button class="sheet-submit" loading="{{sheetSubmitting}}" catchtap="submitSheet">{{sheetSubmitting ? '提交中...' : (sheetType == 'review' ? '提交评价' : '提交投诉')}}</button>
  </view>
</view>
