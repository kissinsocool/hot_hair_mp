@import '../../styles/review-feedback.wxss';

page,
.page {
  min-height: 100%;
  background: #fdfbf9;
}

.page {
  padding: 24rpx;
}

.review-filters {
  display: flex;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #eadbd2;
}

.review-filter {
  flex: 1;
  min-width: 0;
  padding: 20rpx 0;
  border-bottom: 4rpx solid transparent;
  color: #8d817b;
  font-size: 25rpx;
  text-align: center;
}

.review-filter.active {
  border-bottom-color: #d06884;
  color: #d06884;
  font-weight: 600;
}

.review-tag-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.review-tag-count {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f8dce5;
  color: #b95370;
  font-size: 25rpx;
}

.review-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
}

.review-head,
.review-user,
.review-stars {
  display: flex;
  align-items: flex-start;
}

.review-head {
  justify-content: space-between;
  gap: 16rpx;
}

.review-user {
  flex: 1;
  align-items: center;
  min-width: 0;
  gap: 14rpx;
}

.avatar {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fdebf0;
}

.review-name {
  overflow: hidden;
  color: #666;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-sub,
.review-date {
  color: #999;
  font-size: 30rpx;
  line-height: 40rpx;
}

.review-sub {
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-rating-row {
  display: flex;
  align-items: center;
  margin: 14rpx 0 10rpx;
}

.review-stars {
  flex-shrink: 0;
  align-items: center;
  gap: 3rpx;
}

.star-icon {
  width: 40rpx;
  height: 40rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-image {
  width: 140rpx;
  height: 166rpx;
  border-radius: 4rpx;
  background: #eee;
}

.state {
  padding: 96rpx 24rpx;
  color: #8d817b;
  font-size: 28rpx;
  text-align: center;
}

.retry {
  width: 240rpx;
  margin-top: 28rpx;
  background: #d06884;
  color: #fff;
  font-size: 28rpx;
}

.pagination-state {
  padding: 24rpx 0;
  color: #8d817b;
  font-size: 26rpx;
  text-align: center;
}
