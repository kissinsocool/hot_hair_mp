page,
.page {
  min-height: 100%;
  background: #fdfbf9;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.post-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 16rpx;
  background: #fff;
}

.post-head {
  margin-top: 18rpx;
  color: #999;
  font-size: 26rpx;
  text-align: right;
}

.post-content {
  color: #4f4642;
  font-size: 30rpx;
  line-height: 46rpx;
  white-space: pre-wrap;
}

.post-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 18rpx;
}

.post-image {
  width: 100%;
  height: 210rpx;
  border-radius: 8rpx;
  background: #f3ebe6;
}

.state,
.footer-state {
  padding: 96rpx 24rpx;
  color: #8d817b;
  font-size: 28rpx;
  text-align: center;
}

.footer-state {
  padding: 28rpx 24rpx 44rpx;
}

.retry {
  width: 240rpx;
  margin-top: 28rpx;
  background: #d06884;
  color: #fff;
  font-size: 28rpx;
}
