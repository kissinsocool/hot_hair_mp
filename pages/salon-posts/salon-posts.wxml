<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载...</view>
  <view wx:elif="{{errorMessage}}" class="state">
    <view>{{errorMessage}}</view>
    <button class="retry" bindtap="load">重新加载</button>
  </view>
  <view wx:elif="{{!posts.length}}" class="state">暂无动态</view>
  <view wx:else class="post-list">
    <salon-post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" favorite="{{favoritePostIds[item.id]}}" bind:favoritechange="onFavoriteChange" />
    <view wx:if="{{loadingMore}}" class="footer-state">正在加载...</view>
    <view wx:elif="{{!hasMore}}" class="footer-state">没有更多动态了</view>
  </view>
</view>
