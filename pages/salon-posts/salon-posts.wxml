<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载...</view>
  <view wx:elif="{{errorMessage}}" class="state">
    <view>{{errorMessage}}</view>
    <button class="retry" bindtap="load">重新加载</button>
  </view>
  <view wx:elif="{{!posts.length}}" class="state">暂无动态</view>
  <view wx:else class="post-list">
    <view wx:for="{{posts}}" wx:for-index="postIndex" wx:key="id" class="post-card">
      <view class="post-content">{{item.content}}</view>
      <view wx:if="{{item.imageUrls.length}}" class="post-images">
        <image wx:for="{{item.imageUrls}}" wx:for-item="image" wx:key="*this" class="post-image" mode="aspectFill" src="{{image}}" lazy-load bindtap="previewImage" data-url="{{image}}" data-post-index="{{postIndex}}" />
      </view>
      <view class="post-head">
        <text bindtap="openStaff" data-id="{{item.authorStaffId}}" aria-role="button">{{item.authorName}}</text>
        <text> · 投稿时间：{{item.dateText}}</text>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="footer-state">正在加载...</view>
    <view wx:elif="{{!hasMore}}" class="footer-state">没有更多动态了</view>
  </view>
</view>
