.rule-scroll {
  height: 100vh;
  background: #fff;
}

.rule-page {
  box-sizing: border-box;
  padding: 48rpx 40rpx 96rpx;
  color: #666;
}

.rule-title {
  margin-bottom: 40rpx;
  color: #222;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
}

.rule-paragraph {
  margin-bottom: 36rpx;
  font-size: 32rpx;
  line-height: 1.75;
  text-align: justify;
  white-space: pre-line;
  word-break: break-all;
}

.rule-date {
  margin-bottom: 28rpx;
  color: #999;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: left;
}

.rule-section {
  margin-top: 56rpx;
  margin-bottom: 28rpx;
  color: #222;
  font-weight: 700;
}

.rule-subsection {
  margin-top: 40rpx;
  margin-bottom: 24rpx;
  color: #333;
  font-weight: 700;
}

.rule-strong {
  color: #222;
  font-weight: 700;
}

.rule-link {
  color: #576b95;
}
