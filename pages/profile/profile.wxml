<page-meta page-style="{{sheetVisible ? 'overflow: hidden;' : ''}}" />
<view class="profile-page">
  <view wx:if="{{loggedIn}}">
    <view class="profile-card">
      <view class="avatar-ring">
        <image wx:if="{{avatarPreview}}" class="avatar" mode="aspectFill" src="{{avatarPreview}}" />
        <image wx:else class="avatar-placeholder" mode="aspectFit" src="/assets/icons/person_outline.png" />
        <view wx:if="{{avatarReviewStatus == 'pending'}}" class="avatar-review-badge">审核中</view>
      </view>
      <view class="profile-copy">
        <view class="profile-name">{{displayName}}</view>
        <view class="settings-link" bindtap="openSettings">账号设置 <text>›</text></view>
      </view>
    </view>

    <view class="section-tabs">
      <view class="section-tab {{activeTab == 'coupons' ? 'active' : ''}}" data-tab="coupons" bindtap="switchSection">优惠券</view>
      <view class="section-tab {{activeTab == 'reviews' ? 'active' : ''}}" data-tab="reviews" bindtap="switchSection">我的评价</view>
    </view>

    <view wx:if="{{activeTab == 'coupons'}}" class="coupons-section">
      <view wx:if="{{loadingCoupons && !coupons.length}}" class="empty-state"><view class="empty-sub">正在加载...</view></view>
      <view wx:elif="{{couponsLoadFailed && !coupons.length}}" class="empty-state">
        <view class="empty-title">优惠券加载失败</view>
        <view class="empty-sub retry-link" bindtap="retryCoupons">点击重试</view>
      </view>
      <view wx:elif="{{!coupons.length}}" class="empty-state">
        <view class="empty-symbol">券</view>
        <view class="empty-title">暂无优惠券</view>
        <view class="empty-sub">可使用的优惠券会显示在这里</view>
      </view>
      <view wx:else class="coupons-list">
        <view wx:for="{{coupons}}" wx:key="id" class="coupon-item">
          <coupon-ticket coupon="{{item}}" />
        </view>
      </view>
    </view>

    <view wx:elif="{{activeTab == 'reviews'}}" class="reviews-list">
      <view wx:if="{{loadingReviews && !reviews.length}}" class="empty-state"><view class="empty-sub">正在加载...</view></view>
      <view wx:elif="{{!reviews.length}}" class="empty-state">
        <image class="empty-icon" mode="aspectFit" src="/assets/icons/rate_review_outlined.png" />
        <view class="empty-title">暂无评价</view>
        <view class="empty-sub">完成服务并评价后会显示在这里</view>
      </view>
      <view wx:for="{{reviews}}" wx:for-index="reviewIndex" wx:key="bookingId" class="review-card">
        <view class="review-head">
          <view class="review-salon">{{item.salonName}}</view>
          <view class="review-date">{{item.date}}</view>
        </view>
        <view class="review-meta">{{item.metaText}}</view>
        <view class="review-stars"><image wx:for="{{item.starIcons}}" wx:for-item="star" wx:key="*this" mode="aspectFit" src="{{star}}" /></view>
        <view wx:if="{{item.comment}}" class="review-comment">{{item.comment}}</view>
        <view wx:if="{{item.imageUrls.length}}" class="review-images">
          <image wx:for="{{item.imageUrls}}" wx:for-item="image" wx:key="*this" class="review-image" mode="aspectFill" src="{{image}}" lazy-load bindtap="previewReviewImage" data-review-index="{{reviewIndex}}" data-url="{{image}}" />
        </view>
        <view wx:if="{{item.replyText}}" class="merchant-reply">商家回复：{{item.replyText}}</view>
        <view class="review-actions">
          <button class="review-btn edit {{item.isAwaitingReview ? 'disabled' : ''}}" disabled="{{item.isAwaitingReview}}" data-index="{{reviewIndex}}" catchtap="editReview">{{item.editButtonText}}</button>
          <button class="review-btn delete" loading="{{deletingReviewId == item.bookingId}}" data-index="{{reviewIndex}}" catchtap="deleteReview">删除</button>
        </view>
      </view>
      <view wx:if="{{loadingMoreReviews}}" class="empty-sub list-footer">正在加载更多...</view>
      <view wx:elif="{{reviews.length >= 20 && !hasMoreReviews}}" class="empty-sub list-footer">没有更多评价了</view>
    </view>
  </view>

  <view wx:if="{{sheetVisible}}" class="sheet-mask" catchtap="closeSheet"></view>
  <view wx:if="{{sheetVisible}}" class="sheet">
    <view class="sheet-close" catchtap="closeSheet"><image mode="aspectFit" src="/assets/icons/close.png" /></view>
    <scroll-view scroll-y class="sheet-body">
      <view class="sheet-title">编辑评价</view>
      <view class="sheet-info"><image class="inline-icon" mode="aspectFit" src="/assets/icons/storefront_outlined.png" />{{sheetReview.salonName}}</view>
      <view class="sheet-info"><image class="inline-icon" mode="aspectFit" src="/assets/icons/content_cut.png" />{{sheetReview.serviceName}}</view>
      <view class="field-title">选择星级</view>
      <view class="stars-row"><view wx:for="{{sheetStars}}" wx:key="value" class="star-btn {{item.selected ? 'active' : ''}}" data-value="{{item.value}}" catchtap="chooseRating"><image mode="aspectFit" src="{{item.icon}}" /></view></view>
      <view class="review-tags"><view wx:for="{{sheetTags}}" wx:key="name" class="review-tag {{item.selected ? 'active' : ''}}" data-name="{{item.name}}" catchtap="chooseReviewTag">{{item.name}}</view></view>
      <view class="textarea-wrap">
        <textarea class="sheet-textarea" placeholder-class="sheet-placeholder" value="{{sheetContent}}" bindinput="onSheetContent" maxlength="200" placeholder="分享这次服务体验..." />
        <view class="textarea-count">{{sheetContent.length}}/200</view>
      </view>
      <view class="upload-row"><view class="field-title">上传图片 {{sheetImages.length}}/5</view><button class="pick-btn" catchtap="pickImages">选择图片</button></view>
      <view wx:if="{{sheetImages.length}}" class="picked-list"><view wx:for="{{sheetImages}}" wx:for-index="index" wx:key="tempPath" class="picked"><image mode="aspectFill" src="{{item.tempPath}}" /><view class="remove" data-index="{{index}}" catchtap="removeImage"><image mode="aspectFit" src="/assets/icons/close.png" /></view></view></view>
    </scroll-view>
    <button class="sheet-submit" loading="{{sheetSubmitting}}" catchtap="submitEdit">{{sheetSubmitting ? '提交中...' : '提交修改'}}</button>
  </view>
</view>
