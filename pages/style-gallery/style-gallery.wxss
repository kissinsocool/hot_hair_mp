page {
  background: #fff;
}

.gallery {
  min-height: 100vh;
  background: #fff;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.gallery-item,
.gallery-image {
  display: block;
  width: 100%;
  height: 332rpx;
}

.gallery-item {
  overflow: hidden;
  background: #f1f1f1;
}

.gallery-state {
  padding: 180rpx 30rpx;
  color: #888;
  font-size: 28rpx;
  text-align: center;
}

.retry {
  width: 240rpx;
  height: 72rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #2b2726;
  color: #fff;
  font-size: 28rpx;
}

.loading-more {
  padding: 28rpx 0;
  color: #999;
  font-size: 24rpx;
  text-align: center;
}
