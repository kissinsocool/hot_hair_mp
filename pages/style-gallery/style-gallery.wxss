page {
  background: #fff;
}

.gallery {
  min-height: 100vh;
  background: #fff;
}

.gallery-sort {
  display: flex;
  box-sizing: border-box;
  width: 33.333%;
  margin: 16rpx 24rpx 16rpx auto;
  background: #fff;
}

.gallery-sort-option {
  flex: 1;
  padding: 8rpx 4rpx;
  border: 2rpx solid #d9d2ce;
  color: #403937;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.gallery-sort-option:first-child {
  border-radius: 12rpx 0 0 12rpx;
}

.gallery-sort-option:last-child {
  border-left: 0;
  border-radius: 0 12rpx 12rpx 0;
}

.gallery-sort-option.active {
  background: #403937;
  color: #fff;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.gallery-item,
.gallery-image {
  display: block;
  width: 100%;
  height: 332rpx;
}

.gallery-item {
  overflow: hidden;
  background: #f1f1f1;
}

.gallery-state {
  padding: 180rpx 30rpx;
  color: #888;
  font-size: 28rpx;
  text-align: center;
}

.retry {
  width: 240rpx;
  height: 72rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #2b2726;
  color: #fff;
  font-size: 28rpx;
}

.loading-more {
  padding: 28rpx 0;
  color: #999;
  font-size: 24rpx;
  text-align: center;
}
