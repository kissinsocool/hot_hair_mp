.support-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #fffdfb;
}

.problem-input,
.contact-input {
  width: 100%;
  border: 1rpx solid #e8dcd0;
  border-radius: 24rpx;
  background: #fff;
  color: #5a5a5a;
  font-size: 30rpx;
}

.problem-input {
  height: 320rpx;
  padding: 24rpx;
  line-height: 44rpx;
}

.counter {
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
  text-align: right;
}

.contact-input {
  height: 96rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.submit-btn {
  height: 96rpx;
  margin-top: 48rpx;
  border-radius: 999rpx;
  background: #e8a2b0;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
