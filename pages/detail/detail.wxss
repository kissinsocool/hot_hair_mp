@import '../../styles/review-feedback.wxss';
@import '../../styles/service-card.wxss';

.detail {
  min-height: 100vh;
  padding-bottom: 220rpx;
  background: #fffdfb;
}

.detail-top {
  padding: 16rpx 20rpx 20rpx;
  background: #fff;
}

.ad-link {
  display: block;
  height: 142rpx;
  overflow: hidden;
}

.ad-banner {
  width: 100%;
  height: 100%;
}

.hero {
  position: relative;
  height: 254rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 254rpx;
  background: #e8dcd0;
  background-position: center top;
  background-repeat: no-repeat;
  background-size: cover;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.featured-badge {
  display: inline-flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #151d25;
  color: #fff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.detail-heading {
  margin-bottom: 16rpx;
  color: #333;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 48rpx;
  word-break: break-all;
}

.body {
  padding: 0 20rpx;
}

.head-row {
  display: flex;
  align-items: flex-start;
  min-height: 138rpx;
  margin: 0 -20rpx;
  padding: 30rpx 20rpx 20rpx;
  background: #fff;
}

.stars,
.review-stars {
  display: flex;
  align-items: center;
  gap: 3rpx;
  color: #ff9800;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 28rpx;
  letter-spacing: 0;
}

.star-icon {
  width: 36.67rpx;
  height: 36.67rpx;
}

.rating-text {
  margin-left: 8rpx;
  color: #d06884;
  font-size: 31rpx;
  font-weight: 600;
}

.rating-count {
  margin-left: 8rpx;
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
}

.hours {
  display: flex;
  flex-wrap: wrap;
  column-gap: 24rpx;
  margin-top: 14rpx;
  margin-left: 0;
  color: #c8c8c8;
  font-size: 28rpx;
  font-weight: 400;
}

.heart {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.heart image {
  width: 44rpx;
  height: 44rpx;
}

.promo {
  position: relative;
  margin: 10px -20rpx 0;
  background: #fff;
}

.promo-swiper,
.promo-image {
  width: 100%;
  height: 624rpx;
}

.promo-image {
  background: #e8dcd0;
}

.promo-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  background: #fff;
}

.promo-dot {
  width: 13rpx;
  height: 13rpx;
  margin: 0 5rpx;
  border-radius: 999rpx;
  background: #d8d8d8;
}

.promo-dot.active {
  width: 30rpx;
  background: #555;
}

.section {
  margin-top: 46rpx;
}

.card {
  border: 0;
  box-shadow: none;
}

.section-title {
  margin: 0 0 24rpx;
  padding-left: 18rpx;
  border-left: 9rpx solid #635555;
  color: #635555;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.related-salons {
  margin: 46rpx -20rpx 0;
  padding: 32rpx 0 12rpx;
  background: #f5f3f1;
}

.related-salons-title {
  margin: 0 30rpx 24rpx;
  color: #635555;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.related-salons-strip {
  width: 100%;
  white-space: nowrap;
}

.related-salon-card {
  display: inline-block;
  width: 230rpx;
  margin: 0 24rpx 28rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
  vertical-align: top;
}

.related-salon-card:first-child {
  margin-left: 30rpx;
}

.related-salon-card:last-child {
  margin-right: 30rpx;
}

.related-salon-image {
  display: block;
  width: 230rpx;
  height: 172rpx;
  background: #e8dcd0;
}

.related-salon-name {
  display: -webkit-box;
  height: 114rpx;
  margin: 24rpx;
  overflow: hidden;
  color: #333;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 38rpx;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.reviews-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.reviews-heading .section-title {
  margin-bottom: 0;
}

.reviews-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: auto;
  padding: 8rpx 0 8rpx 24rpx;
  background: transparent;
  color: #8a8a8a;
  font-size: 27rpx;
  font-weight: 400;
}

.reviews-all-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
}

.reviews-all-arrow::after {
  content: '';
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #b8b8b8;
  border-right: 3rpx solid #b8b8b8;
  transform: rotate(45deg);
}

.salon-intro {
  margin: 0 0 36rpx;
  color: #343434;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 50rpx;
  white-space: pre-wrap;
}

.info-card {
  margin: 0;
  padding: 18rpx 26rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 24rpx;
  background: #fff;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 52rpx;
  color: #777;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-label {
  flex: 0 0 74rpx;
  color: #777;
}

.info-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #d06884;
  font-size: 31rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.after-sales {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.after-sales-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 40rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eeeeee;
  color: #66575a;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.after-sales-icon {
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
}

.staff-strip {
  width: 100%;
  height: 556rpx;
  padding: 8rpx 0 24rpx;
  white-space: nowrap;
}

.staff-card {
  display: inline-block;
  width: 277rpx;
  height: 524rpx;
  margin-right: 12rpx;
  overflow: hidden;
  border: 1rpx solid #eadbd2;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
  vertical-align: top;
}

.staff-photo {
  width: 277rpx;
  height: 332rpx;
  background: #e8dcd0;
}

.staff-info {
  padding: 10rpx 8rpx;
}

.staff-name {
  overflow: hidden;
  color: #666;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role {
  overflow: hidden;
  margin-top: 8rpx;
  color: #d06884;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-bio {
  display: -webkit-box;
  overflow: hidden;
  color: #777;
  font-size: 28rpx;
  line-height: 38rpx;
  white-space: normal;
  -webkit-box-orient: vertical;
}

.staff-bio {
  margin-top: 12rpx;
  -webkit-line-clamp: 2;
}

.salon-posts-strip {
  width: calc(100% + 40rpx);
  margin: 0 -20rpx;
  white-space: nowrap;
}

.salon-posts-row {
  display: flex;
  align-items: stretch;
  width: 100%;
  padding: 24rpx 20rpx 40rpx;
}

.salon-post {
  flex: 0 0 88%;
  box-sizing: border-box;
  min-width: 0;
  margin-right: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
  white-space: normal;
}

.salon-post:last-child {
  margin-right: 0;
}

.salon-post-head {
  margin-top: 16rpx;
  color: #999;
  font-size: 25rpx;
  text-align: right;
}

.salon-post-content {
  color: #000;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 44rpx;
  white-space: pre-wrap;
}

.salon-post-service {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  min-height: 174rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 2rpx solid #e1e1e1;
  border-radius: 20rpx;
  background: #fff;
}

.salon-post-service-label {
  display: flex;
  flex: 0 0 58rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #d67590;
  color: #fff;
  font-size: 23rpx;
  line-height: 27rpx;
  text-align: center;
}

.salon-post-service-main {
  flex: 1;
  min-width: 0;
}

.salon-post-service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.salon-post-service-name {
  color: #363636;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 37rpx;
  word-break: break-all;
}

.salon-post-service-note {
  margin-top: 8rpx;
  color: #363636;
  font-size: 27rpx;
  line-height: 35rpx;
}

.salon-post-service-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 12rpx;
}


.salon-post-service-arrow {
  align-self: center;
  box-sizing: border-box;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  border-top: 5rpx solid #b8b8b8;
  border-right: 5rpx solid #b8b8b8;
  transform: rotate(45deg);
}

.salon-post-service-unavailable {
  margin-top: 12rpx;
  color: #999;
  font-size: 25rpx;
}

.salon-post-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}

.salon-post-image {
  width: 100%;
  height: 188rpx;
  border-radius: 8rpx;
  background: #f3ebe6;
}

.review {
  margin-bottom: 12rpx;
  padding: 18rpx 16rpx 14rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
}

.review-tag-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 18rpx 0 24rpx;
}

.review-tag-count {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f8dce5;
  color: #b95370;
  font-size: 25rpx;
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-user {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  gap: 14rpx;
}

.avatar {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fdebf0;
}

.review-name {
  overflow: hidden;
  color: #666;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-sub,
.review-date {
  color: #999;
  font-size: 30rpx;
  line-height: 40rpx;
}

.review-sub {
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-rating-row {
  display: flex;
  align-items: center;
  margin: 14rpx 0 10rpx;
}

.review-stars {
  flex-shrink: 0;
}

.review-stars .star-icon {
  width: 40rpx;
  height: 40rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-image {
  width: 140rpx;
  height: 166rpx;
  border-radius: 4rpx;
  background: #eee;
}

.ghost-btn {
  height: 90rpx;
  line-height: 90rpx;
  margin-top: 14rpx;
  border: 1rpx solid #d06884;
  border-radius: 999rpx;
  background: #fff;
  color: #d06884;
  font-size: 32rpx;
  font-weight: 700;
}

.bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.primary-btn {
  width: 100% !important;
  margin: 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: #d06884;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.primary-btn::after,
.ghost-btn::after {
  border: 0;
}
