@import '../../styles/review-feedback.wxss';
@import '../../styles/service-card.wxss';
@import '../../styles/featured-badge.wxss';

.detail {
  min-height: 100vh;
  padding-bottom: 220rpx;
  background: #fffdfb;
}

.detail-top {
  padding: 16rpx 20rpx 20rpx;
  background: #fff;
}

.ad-link {
  display: block;
  height: 142rpx;
  overflow: hidden;
}

.ad-banner {
  width: 100%;
  height: 100%;
}

.head-main {
  flex: 1;
  min-width: 0;
}

/* 店铺名称上方一行：左侧商圈（可选），右侧收藏按钮；精选标签单独在这一行上方。 */
.head-top {
  display: flex;
  align-items: center;
  min-height: 44rpx;
  margin-bottom: 16rpx;
}

.featured-badge {
  margin-bottom: 16rpx;
}

.detail-heading {
  margin-bottom: 16rpx;
  color: #333;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 48rpx;
  word-break: break-all;
}

.body {
  padding: 0 20rpx;
}

.head-row {
  display: flex;
  align-items: flex-start;
  min-height: 138rpx;
  margin: 0 -20rpx;
  padding: 30rpx 20rpx 20rpx;
  background: #fff;
}

.stars {
  display: flex;
  align-items: center;
  gap: 3rpx;
  color: #ff9800;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 28rpx;
  letter-spacing: 0;
}

.star-icon {
  width: 30rpx;
  height: 30rpx;
}

.rating-text {
  margin-left: 8rpx;
  color: #d06884;
  font-size: 31rpx;
  font-weight: 600;
}

.rating-count {
  margin-left: 8rpx;
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
}

.hours {
  display: flex;
  flex-wrap: wrap;
  column-gap: 24rpx;
  margin-top: 14rpx;
  margin-left: 0;
  color: #c8c8c8;
  font-size: 28rpx;
  font-weight: 400;
}

.head-district {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #66575a;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.heart {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: -10rpx -10rpx -10rpx auto;
}

.heart image {
  width: 56rpx;
  height: 56rpx;
}

.promo {
  position: relative;
  margin: 10px -20rpx 0;
  background: #fff;
}

.promo-swiper,
.promo-image {
  width: 100%;
  height: 624rpx;
}

.promo-image {
  background: #e8dcd0;
}

.promo-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  background: #fff;
}

.promo-dot {
  width: 13rpx;
  height: 13rpx;
  margin: 0 5rpx;
  border-radius: 999rpx;
  background: #d8d8d8;
}

.promo-dot.active {
  width: 30rpx;
  background: #555;
}

.section {
  margin-top: 46rpx;
}

.card {
  border: 0;
  box-shadow: none;
}

.section-title {
  margin: 0 0 24rpx;
  padding-left: 18rpx;
  border-left: 9rpx solid #635555;
  color: #635555;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 42rpx;
}

/* 位置标记需要有高度才能被相交观察到。 */
.related-salons-anchor {
  height: 1px;
}

.related-salons {
  margin: 46rpx -20rpx 0;
  padding: 32rpx 0 12rpx;
  background: #f5f3f1;
}

.related-salons-title {
  margin: 0 30rpx 24rpx;
  color: #635555;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.related-salons-strip {
  width: 100%;
  white-space: nowrap;
}

.related-salon-card {
  display: inline-block;
  width: 230rpx;
  margin: 0 24rpx 28rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
  vertical-align: top;
}

.related-salon-card:first-child {
  margin-left: 30rpx;
}

.related-salon-card:last-child {
  margin-right: 30rpx;
}

.related-salon-image {
  display: block;
  width: 230rpx;
  height: 172rpx;
  background: #e8dcd0;
}

.related-salon-name {
  display: -webkit-box;
  height: 114rpx;
  margin: 24rpx;
  overflow: hidden;
  color: #333;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 38rpx;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-heading .section-title {
  margin-bottom: 0;
}

.section-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: auto;
  padding: 8rpx 0 8rpx 24rpx;
  background: transparent;
  color: #8a8a8a;
  font-size: 27rpx;
  font-weight: 400;
}

.section-all-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
}

.section-all-arrow::after {
  content: '';
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #b8b8b8;
  border-right: 3rpx solid #b8b8b8;
  transform: rotate(45deg);
}

.salon-intro {
  margin: 0 0 36rpx;
  color: #343434;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 50rpx;
  white-space: pre-wrap;
}

.info-card {
  margin: 0;
  padding: 18rpx 26rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 24rpx;
  background: #fff;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 52rpx;
  color: #777;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-label {
  flex: 0 0 74rpx;
  color: #777;
}

.info-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #d06884;
  font-size: 31rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.after-sales {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.after-sales-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 40rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eeeeee;
  color: #66575a;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.after-sales-icon {
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
}

.staff-strip {
  width: 100%;
  height: 556rpx;
  padding: 8rpx 0 24rpx;
  white-space: nowrap;
}

.staff-card {
  display: inline-block;
  width: 277rpx;
  height: 524rpx;
  margin-right: 12rpx;
  overflow: hidden;
  border: 1rpx solid #eadbd2;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
  vertical-align: top;
}

.staff-photo {
  width: 277rpx;
  height: 332rpx;
  background: #e8dcd0;
}

.staff-info {
  padding: 10rpx 8rpx;
}

.staff-name {
  overflow: hidden;
  color: #666;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role {
  overflow: hidden;
  margin-top: 8rpx;
  color: #d06884;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-bio {
  display: -webkit-box;
  overflow: hidden;
  color: #777;
  font-size: 28rpx;
  line-height: 38rpx;
  white-space: normal;
  -webkit-box-orient: vertical;
}

.staff-bio {
  margin-top: 12rpx;
  -webkit-line-clamp: 2;
}

.salon-posts-strip {
  width: calc(100% + 40rpx);
  margin: 0 -20rpx;
  white-space: nowrap;
}

.salon-posts-row {
  display: flex;
  align-items: stretch;
  width: 100%;
  padding: 24rpx 0 40rpx 20rpx;
}

/* 卡片超出容器宽度后，容器的右内边距不会出现在最后一张卡片之后，改用占位留出右侧边距。 */
.salon-posts-row::after {
  content: '';
  flex: 0 0 20rpx;
}

.salon-post-slide {
  display: flex;
  flex: 0 0 82%;
  min-width: 0;
  margin-right: 20rpx;
}

.salon-post-slide:last-child {
  margin-right: 0;
}

.salon-posts-all {
  display: flex;
  position: relative;
  flex: 0 0 80rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 24rpx 0;
  border: 1rpx solid #eadbd2;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
  color: #8a8a8a;
  font-size: 26rpx;
  white-space: nowrap;
}

.salon-posts-all-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 34rpx;
}

/* 箭头不参与排版，文字始终在卡片正中。 */
.salon-posts-all-arrow {
  position: absolute;
  top: 50%;
  right: 10rpx;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  margin-top: -7rpx;
  border-top: 3rpx solid #b8b8b8;
  border-right: 3rpx solid #b8b8b8;
  transform: rotate(45deg);
}

.review {
  margin-bottom: 12rpx;
  padding: 18rpx 16rpx 14rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 67, 56, 0.12);
}

.review-tag-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 18rpx 0 24rpx;
}

.review-tag-count {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f8dce5;
  color: #b95370;
  font-size: 25rpx;
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-user {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  gap: 14rpx;
}

.avatar {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fdebf0;
}

.review-name {
  overflow: hidden;
  color: #666;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-date {
  color: #999;
  font-size: 30rpx;
  line-height: 40rpx;
}

.review-date {
  margin-top: 8rpx;
  margin-bottom: 6rpx;
}



.review-rating-row {
  width: 100%;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-image {
  width: 140rpx;
  height: 166rpx;
  border-radius: 4rpx;
  background: #eee;
}

.bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.primary-btn {
  width: 100% !important;
  margin: 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: #d06884;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.primary-btn::after {
  border: 0;
}


/* 加载占位：配合 detail.wxml 中的 detail-body-skeleton 模板，尺寸与对应的真实内容一致。 */

.detail-skeleton-district {
  width: 140rpx;
  height: 32rpx;
  margin: 6rpx 0 22rpx;
}

.detail-skeleton-heading {
  width: 64%;
  height: 36rpx;
  margin: 6rpx 0 22rpx;
}

.detail-skeleton-stars {
  width: 300rpx;
  height: 28rpx;
  margin: 0;
}

.detail-skeleton-hours {
  width: 52%;
  height: 28rpx;
  margin: 20rpx 0 4rpx;
}

/* 介绍文字行高 50rpx：30rpx 占位块上下各留 10rpx。 */
.detail-skeleton-text {
  height: 30rpx;
  margin: 10rpx 0;
}

.detail-skeleton-text--last {
  width: 58%;
}

.detail-skeleton-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.detail-skeleton-info {
  width: 68%;
  height: 30rpx;
  margin: 0;
}





