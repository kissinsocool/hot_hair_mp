.detail {
  min-height: 100vh;
  padding-bottom: 220rpx;
  background: #fffdfb;
}

.detail-top {
  padding: 16rpx 20rpx 20rpx;
  background: #fff;
}

.ad-link {
  display: block;
  height: 142rpx;
  overflow: hidden;
}

.ad-banner {
  width: 100%;
  height: 100%;
}

.hero {
  position: relative;
  height: 254rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 254rpx;
  background: #e8dcd0;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.03), rgba(0, 0, 0, 0.5));
}

.hero-title {
  position: absolute;
  right: 34rpx;
  bottom: 34rpx;
  left: 84rpx;
  overflow: hidden;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.45);
  white-space: nowrap;
}

.body {
  padding: 0 20rpx;
}

.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 138rpx;
  margin: 0 -20rpx;
  padding: 30rpx 20rpx 20rpx;
  background: #fff;
}

.stars,
.review-stars {
  display: flex;
  align-items: center;
  gap: 3rpx;
  color: #ff9800;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 28rpx;
  letter-spacing: 0;
}

.star-icon {
  width: 36.67rpx;
  height: 36.67rpx;
}

.rating-text {
  margin-left: 8rpx;
  color: #777;
  font-size: 31rpx;
  font-weight: 600;
}

.hours {
  margin-top: 14rpx;
  margin-left: 0;
  color: #c8c8c8;
  font-size: 28rpx;
}

.heart {
  width: 58rpx;
  height: 58rpx;
}

.heart image {
  width: 58rpx;
  height: 58rpx;
}

.promo {
  position: relative;
  margin: 10px -20rpx 0;
  background: #fff;
}

.promo-swiper,
.promo-image {
  width: 100%;
  height: 624rpx;
}

.promo-image {
  background: #e8dcd0;
}

.promo-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  background: #fff;
}

.promo-dot {
  width: 13rpx;
  height: 13rpx;
  margin: 0 5rpx;
  border-radius: 999rpx;
  background: #d8d8d8;
}

.promo-dot.active {
  width: 30rpx;
  background: #555;
}

.section,
.plain-section {
  margin-top: 46rpx;
}

.card {
  border: 0;
  box-shadow: none;
}

.section-title {
  margin: 0 0 16rpx;
  padding-left: 18rpx;
  border-left: 7rpx solid #6f5f58;
  color: #5a5a5a;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.promo + .section-title {
  margin-top: 28rpx;
}

.info-card {
  margin: 0;
  padding: 18rpx 26rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 24rpx;
  background: #fff;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 52rpx;
  color: #777;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-label {
  flex: 0 0 74rpx;
  color: #777;
}

.info-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #d06884;
  font-size: 31rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  color: #666;
  font-size: 31rpx;
  line-height: 40rpx;
}

.plain-section .desc {
  line-height: 46rpx;
}

.service-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  min-height: 184rpx;
  margin-bottom: 18rpx;
  padding: 14rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 24rpx;
  background: #fff;
}

.service-image {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background: #eee;
}

.service-main {
  display: flex;
  flex: 1;
  height: 140rpx;
  min-width: 0;
  justify-content: space-between;
  gap: 18rpx;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.service-tag {
  padding: 3rpx 12rpx;
  background: #fde4eb;
  color: #d06884;
  font-size: 25rpx;
  line-height: 32rpx;
}

.service-name {
  overflow: hidden;
  color: #606060;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-note {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #777;
  font-size: 27rpx;
  line-height: 38rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.service-meta {
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
  justify-content: space-between;
  text-align: right;
}

.service-duration {
  color: #999;
  font-size: 28rpx;
  line-height: 40rpx;
}

.price {
  color: #d06884;
  font-size: 34rpx;
  font-weight: 800;
}

.staff-strip {
  width: 100%;
  height: 532rpx;
  white-space: nowrap;
}

.staff-card {
  display: inline-block;
  width: 277rpx;
  height: 524rpx;
  margin-right: 12rpx;
  overflow: hidden;
  border: 1rpx solid #eadbd2;
  border-radius: 10rpx;
  background: #fff;
  vertical-align: top;
}

.staff-photo {
  width: 277rpx;
  height: 332rpx;
  background: #e8dcd0;
}

.staff-info {
  padding: 10rpx 8rpx;
}

.staff-name {
  overflow: hidden;
  color: #666;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role {
  overflow: hidden;
  margin-top: 8rpx;
  color: #d06884;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-bio {
  display: -webkit-box;
  overflow: hidden;
  color: #777;
  font-size: 28rpx;
  line-height: 38rpx;
  white-space: normal;
  -webkit-box-orient: vertical;
}

.staff-bio {
  margin-top: 12rpx;
  -webkit-line-clamp: 2;
}

.review {
  margin-bottom: 12rpx;
  padding: 18rpx 16rpx 14rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 14rpx;
  background: #fff;
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-user {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  gap: 14rpx;
}

.avatar {
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fdebf0;
}

.review-name {
  overflow: hidden;
  color: #666;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-sub,
.review-date {
  color: #999;
  font-size: 23rpx;
  line-height: 32rpx;
}

.review-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 36rpx;
}

.review-stars {
  margin-top: 14rpx;
  margin-bottom: 10rpx;
}

.review-stars .star-icon {
  width: 27.5rpx;
  height: 27.5rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-image {
  width: 128rpx;
  height: 152rpx;
  border-radius: 4rpx;
  background: #eee;
}

.ghost-btn {
  height: 90rpx;
  line-height: 90rpx;
  margin-top: 14rpx;
  border: 1rpx solid #d06884;
  border-radius: 999rpx;
  background: #fff;
  color: #d06884;
  font-size: 32rpx;
  font-weight: 700;
}

.bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.primary-btn {
  width: 100% !important;
  margin: 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: #d06884;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.primary-btn::after,
.ghost-btn::after {
  border: 0;
}
