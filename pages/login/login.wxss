.login-page {
  min-height: 100vh;
  padding-top: 20rpx;
}

.hero {
  position: relative;
  width: 100%;
  height: 520rpx;
  padding: 0;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.28);
}

.brand {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
}

.phone-login-btn {
  width: 100%;
  margin-top: 30px;
  border-radius: 16rpx;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  color: #9a8f88;
  font-size: 30rpx;
  text-align: center;
}

.agreement-icon {
  width: 34rpx;
  height: 34rpx;
}
