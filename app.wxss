page {
  box-sizing: border-box;
  min-height: 100%;
  background: #fdfbf9;
  color: #5a5a5a;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view,
text,
image,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 0;
  line-height: normal !important;
}

button::after {
  border: 0;
}

.button-hover {
  background: inherit;
  opacity: 1;
}

.page {
  padding: 20rpx;
}

.native-tab-header-extension {
  position: sticky;
  top: 0;
  z-index: 10;
  height: 25rpx;
  border-bottom: 1rpx solid #b2b2b2;
  background: #ffffff;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e8dcd0;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.primary-btn {
  width: 100% !important;
  height: 80rpx;
  line-height: 80rpx;
  margin-right: 0;
  margin-left: 0;
  border-radius: 999rpx;
  background: #d06884;
  color: #ffffff;
  font-weight: 700;
  font-size: 36rpx;
}

.ghost-btn {
  width: 100% !important;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 0;
  margin-left: 0;
  border: 1rpx solid #d06884;
  border-radius: 16rpx;
  background: #fff;
  color: #d06884;
  font-weight: 700;
  font-size: 32rpx;
}

.danger-btn {
  width: 100% !important;
  height: 60rpx;
  line-height: 60rpx;
  margin-right: 0;
  margin-left: 0;
  border: 1rpx solid #d94b4b;
  border-radius: 999rpx;
  background: #fff;
  color: #d94b4b;
  font-weight: 700;
  font-size: 28rpx;
}

.bar .primary-btn {
  width: 100% !important;
  margin: 0;
  font-size: 36rpx;
  font-weight: 700;
}

.muted {
  color: #8a8a8a;
}

.empty {
  padding: 120rpx 24rpx;
  text-align: center;
  color: #8a8a8a;
}

.page-error {
  padding: 160rpx 48rpx;
  text-align: center;
}

.page-error-title {
  color: #5a5a5a;
  font-size: 32rpx;
  font-weight: 800;
}

.page-error-sub {
  margin-top: 12rpx;
  color: #8a8a8a;
  font-size: 26rpx;
}

.page-error .page-error-retry {
  width: 320rpx !important;
  margin: 40rpx auto 0;
}

.section-title {
  margin: 28rpx 0 20rpx;
  color: #5a5a5a;
  font-size: 36rpx;
  font-weight: 800;
}

.one-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.icon-img {
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

.salon-image {
  width: 45%;
  min-width: 300rpx;
  max-width: 356rpx;
  height: 264rpx;
  flex: 0 0 45%;
  background: #eee;
}

.salon-name {
  flex: 1;
  min-width: 0;
  max-height: 76rpx;
  overflow: hidden;
  color: #5a5a5a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 38rpx;
}

/* 加载占位（骨架屏）：首次加载时按页面结构画出内容位置，颜色与首页占位卡片一致。 */
.skeleton {
  padding: 24rpx 20rpx;
}

.skeleton--flush {
  padding: 0;
}

.skeleton-line,
.skeleton-block {
  background: #f3ece8;
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

.skeleton-line {
  width: 100%;
  height: 28rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
}


.skeleton-line--mid {
  width: 72%;
}

.skeleton-line--short {
  width: 40%;
}

.skeleton-block {
  border-radius: 12rpx;
}

.skeleton-flat {
  border-radius: 0;
}


.skeleton-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #efe6df;
  border-radius: 16rpx;
  background: #ffffff;
}

.skeleton-row {
  display: flex;
  align-items: flex-start;
}

.skeleton-thumb {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  margin-right: 24rpx;
}


.skeleton-row-body {
  flex: 1;
  min-width: 0;
}

.skeleton-row-body .skeleton-line:first-child {
  margin-top: 4rpx;
}




@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton-line,
  .skeleton-block { animation: none; }
}
